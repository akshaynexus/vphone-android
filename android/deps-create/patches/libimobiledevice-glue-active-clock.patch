+#ifndef _WIN32
+/* vphone: the active clock. A thread ticks every 100 ms; the time between two ticks counts,
+ * but never more than a second of it. A process that was stopped comes back to one tick that
+ * is minutes long, of which a second is counted. A reader between ticks applies the same
+ * limit to the time since the last tick, so the first thread to wake after a stop already
+ * reads the right time. */
+#define VPHONE_ACTIVE_TICK_NS 100000000ULL
+#define VPHONE_ACTIVE_GAP_LIMIT_NS 1000000000ULL
+
+static pthread_once_t vphone_active_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t vphone_active_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t vphone_active_counted_ns;
+static uint64_t vphone_active_last_ns;
+
+static uint64_t vphone_monotonic_ns(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+static uint64_t vphone_active_pending(uint64_t now)
+{
+	uint64_t gap = now > vphone_active_last_ns ? now - vphone_active_last_ns : 0;
+	return gap < VPHONE_ACTIVE_GAP_LIMIT_NS ? gap : VPHONE_ACTIVE_GAP_LIMIT_NS;
+}
+
+static void* vphone_active_ticker(void* arg)
+{
+	(void)arg;
+	for (;;) {
+		struct timespec tick = { 0, VPHONE_ACTIVE_TICK_NS };
+		nanosleep(&tick, NULL);
+		pthread_mutex_lock(&vphone_active_lock);
+		uint64_t now = vphone_monotonic_ns();
+		vphone_active_counted_ns += vphone_active_pending(now);
+		vphone_active_last_ns = now;
+		pthread_mutex_unlock(&vphone_active_lock);
+	}
+	return NULL;
+}
+
+static void vphone_active_start(void)
+{
+	pthread_t thread;
+	vphone_active_last_ns = vphone_monotonic_ns();
+	/* Without the ticker the clock is still monotonic, only slow: waits get longer, not shorter. */
+	if (pthread_create(&thread, NULL, vphone_active_ticker, NULL) == 0) {
+		pthread_detach(thread);
+	}
+}
+
+uint64_t vphone_active_ms(void)
+{
+	pthread_once(&vphone_active_once, vphone_active_start);
+	pthread_mutex_lock(&vphone_active_lock);
+	uint64_t ns = vphone_active_counted_ns + vphone_active_pending(vphone_monotonic_ns());
+	pthread_mutex_unlock(&vphone_active_lock);
+	return ns / 1000000ULL;
+}
+#endif
