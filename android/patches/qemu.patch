+
+typedef struct VsockUdsConn VsockUdsConn;
+typedef struct VsockUdsCtrl VsockUdsCtrl;
+
+struct VirtIOVsockUds {
+    VirtIODevice parent_obj;
+
+    VirtQueue *rx_vq;
+    VirtQueue *tx_vq;
+    VirtQueue *event_vq;
+
+    uint64_t guest_cid;
+    char *uds_path;
+    bool credit_request;
+
+    int listen_fd;
+    uint32_t next_host_port;
+    int debug;
+    bool rx_starved;
+
+    QEMUTimer *timer;
+    QTAILQ_HEAD(, VsockUdsConn) conns;
+    QTAILQ_HEAD(, VsockUdsCtrl) ctrl;
+};
