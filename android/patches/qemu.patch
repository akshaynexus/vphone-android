+#ifdef CONFIG_ANDROID
+/*
+ * The entry point of libqemu-vphone.so: QEMU's main() for an app's process, on
+ * the caller's thread. QEMU's global state cannot be built twice, so an app
+ * runs one VM per process and ends that process after this returns.
+ */
+int qemu_android_main(int argc, char **argv);
+
+int qemu_android_main(int argc, char **argv)
+{
+    static bool started;
+    int status;
+
+    if (qatomic_xchg(&started, true)) {
+        return 1;
+    }
+
+    /* qemu_init leaves the BQL and the replay mutex held for this thread. */
+    qemu_init(argc, argv);
+    status = qemu_main_loop();
+    qemu_cleanup(status);
+    bql_unlock();
+    replay_mutex_unlock();
+    return status;
+}
