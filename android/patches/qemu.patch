+ * NEP/AH/FIZ are never set (the translator only uses the native path when
+ * the guest has them clear; see fp_native_ok()).
+ *
  * Ported from Inferno (AppleHax) 2eed395 "arm: native A64 FP / NEON on TCG".
  *
  * While a vCPU thread runs generated code (between cpu_exec_enter and
@@ -27,7 +34,153 @@
 /* Set once at startup from VPHONE_NATIVE_FP (default on); see cpu.c. */
 extern bool arm_native_fp_enabled;
 
-#if defined(__x86_64__) && defined(CONFIG_TCG)
+#if defined(__aarch64__) && defined(CONFIG_TCG)
+
+/* FPCR bits that follow the guest; everything else stays as the host's. */
+#define ARM_HOST_FPCR_GUEST (FPCR_AHP | FPCR_DN | FPCR_FZ | FPCR_FZ16 | \
+                             (3u << 22) /* RMode */)
+/* IOC DZC OFC UFC IXC IDC; QC is the guest's vfp.qc, not ours to fold. */
+#define ARM_HOST_FPSR_FLAGS (FPSR_IOC | FPSR_DZC | FPSR_OFC | FPSR_UFC | \
+                             FPSR_IXC | FPSR_IDC)
+
+static inline uint64_t arm_host_fpcr_read(void)
+{
+    uint64_t v;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(v));
+    return v;
+}
+
+static inline void arm_host_fpcr_write(uint64_t v)
+{
+    __asm__ volatile("msr fpcr, %0" :: "r"(v));
+}
+
+static inline uint64_t arm_host_fpsr_read(void)
+{
+    uint64_t v;
+    __asm__ volatile("mrs %0, fpsr" : "=r"(v));
+    return v;
+}
+
+static inline void arm_host_fpsr_write(uint64_t v)
+{
+    __asm__ volatile("msr fpsr, %0" :: "r"(v));
+}
+
+static inline bool arm_host_fp_mine(CPUARMState *env)
+{
+    return env->host_fp_active && current_cpu == env_cpu(env);
+}
+
+static inline uint64_t arm_host_fpcr_want(CPUARMState *env, uint64_t cur)
+{
+    return (cur & ~(uint64_t)ARM_HOST_FPCR_GUEST) |
+           (env->vfp.fpcr & ARM_HOST_FPCR_GUEST);
+}
+
+static inline void arm_host_fpcr_enter(CPUARMState *env)
+{
+    uint64_t saved, want;
+
+    if (!arm_native_fp_enabled) {
+        return;
+    }
+    saved = arm_host_fpcr_read();
+    want = arm_host_fpcr_want(env, saved);
+    env->host_fpcr_saved = saved;
+    env->host_fp_active = true;
+    if (want != saved) {
+        arm_host_fpcr_write(want);
+    }
+    /* The C runtime's flags are not the guest's. */
+    if (arm_host_fpsr_read() & ARM_HOST_FPSR_FLAGS) {
+        arm_host_fpsr_write(0);
+    }
+}
+
+/*
+ * The translator's C code, not the guest, runs between a TB's lookup miss
+ * and its first execution, and some of it raises FP flags (glib's
+ * GHashTable, behind TCG's constant cache, raises Inexact). The host FPSR
+ * holds the guest's accumulated flags during that time, so they are saved at
+ * the start of translation; tcg_out_tb_start() puts them back after the
+ * passes that use the hash table. See tcg/aarch64/tcg-target.c.inc.
+ */
+extern __thread uint64_t tcg_aarch64_guest_fpsr;
+extern __thread bool tcg_aarch64_guest_fpsr_valid;
+
+static inline void arm_host_fpsr_translation_save(void)
+{
+    if (arm_native_fp_enabled) {
+        tcg_aarch64_guest_fpsr = arm_host_fpsr_read();
+        tcg_aarch64_guest_fpsr_valid = true;
+    }
+}
+
+/* Must not change state: the cpreg reset check reads FPSR twice. */
+static inline uint64_t arm_host_fpsr_peek(CPUARMState *env)
+{
+    if (!arm_host_fp_mine(env)) {
+        return 0;
+    }
+    return arm_host_fpsr_read() & ARM_HOST_FPSR_FLAGS;
+}
+
+static inline void arm_host_fpsr_drain(CPUARMState *env)
+{
+    uint64_t cur;
+
+    if (!arm_host_fp_mine(env)) {
+        return;
+    }
+    cur = arm_host_fpsr_read();
+    if (!(cur & ARM_HOST_FPSR_FLAGS)) {
+        return;
+    }
+    env->vfp.fpsr |= cur & ARM_HOST_FPSR_FLAGS;
+    arm_host_fpsr_write(cur & ~(uint64_t)ARM_HOST_FPSR_FLAGS);
+}
+
+/* The guest wrote FPSR (or reset it): forget what the host accumulated. */
+static inline void arm_host_fpsr_ack(CPUARMState *env)
+{
+    uint64_t cur;
+
+    if (!arm_host_fp_mine(env)) {
+        return;
+    }
+    cur = arm_host_fpsr_read();
+    if (cur & ARM_HOST_FPSR_FLAGS) {
+        arm_host_fpsr_write(cur & ~(uint64_t)ARM_HOST_FPSR_FLAGS);
+    }
+}
+
+/* The guest wrote FPCR (or reset it): follow it. */
+static inline void arm_host_fpcr_reload(CPUARMState *env)
+{
+    uint64_t cur, want;
+
+    if (!arm_host_fp_mine(env)) {
+        return;
+    }
+    cur = arm_host_fpcr_read();
+    want = arm_host_fpcr_want(env, cur);
+    if (cur != want) {
+        arm_host_fpcr_write(want);
+    }
+}
+
+static inline void arm_host_fpcr_exit(CPUARMState *env)
+{
+    if (!arm_host_fp_mine(env)) {
+        return;
+    }
+    arm_host_fpsr_drain(env);
+    arm_host_fpcr_write(env->host_fpcr_saved);
+    env->host_fp_active = false;
+}
