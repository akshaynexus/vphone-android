diff --git a/target/arm/tcg/crypto_sha_host.h b/target/arm/tcg/crypto_sha_host.h
new file mode 100644
index 0000000000000000000000000000000000000000..814314f6e9da741e190a1cf05ece8b9c3328d945
--- /dev/null
+++ b/target/arm/tcg/crypto_sha_host.h
@@ -0,0 +1,114 @@
+/*
+ * The guest's SHA-1, SHA-256 and SHA-512 instructions, by the same
+ * instructions on an AArch64 host that has them
+ *
+ * An iOS restore hashes everything it writes: on a PC, a third of the CPU
+ * time of the image write was in the C versions of these helpers. Each
+ * guest instruction maps to the host's identical one. SHA-1 is what the
+ * restore's image receiver checks every chunk with, and what SSH's
+ * hmac-sha1 uses.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef TARGET_ARM_CRYPTO_SHA_HOST_H
+#define TARGET_ARM_CRYPTO_SHA_HOST_H
+
+#if defined(__aarch64__) && defined(__clang__) && !HOST_BIG_ENDIAN
+#define HAVE_HOST_SHA2 1
+
+#include <arm_neon.h>
+
+/* clang's "sha2" feature is the ARMv8 SHA1 and SHA2 pair, as -march=+sha2 is. */
+#define HOST_SHA1 __attribute__((target("sha2")))
+#define HOST_SHA256 __attribute__((target("sha2")))
+#define HOST_SHA512 __attribute__((target("sha3")))
+
+static inline uint32x4_t host_q32(const void *p)
+{
+    return vld1q_u32(p);
+}
+
+static inline uint64x2_t host_q64(const void *p)
+{
+    return vld1q_u64(p);
+}
+
+/* SHA1C/P/M take the hash's e from the low word of n; the rest of n is ignored. */
+static inline HOST_SHA1 void host_sha1c(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha1cq_u32(host_q32(d), vgetq_lane_u32(host_q32(n), 0),
+                             host_q32(m)));
+}
+
+static inline HOST_SHA1 void host_sha1p(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha1pq_u32(host_q32(d), vgetq_lane_u32(host_q32(n), 0),
+                             host_q32(m)));
+}
+
+static inline HOST_SHA1 void host_sha1m(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha1mq_u32(host_q32(d), vgetq_lane_u32(host_q32(n), 0),
+                             host_q32(m)));
+}
+
+/* SHA1H writes the rotated low word and zeroes the rest of the register. */
+static inline HOST_SHA1 void host_sha1h(void *d, void *m)
+{
+    uint32_t e = vsha1h_u32(vgetq_lane_u32(host_q32(m), 0));
+    vst1q_u32(d, vsetq_lane_u32(e, vdupq_n_u32(0), 0));
+}
+
+static inline HOST_SHA1 void host_sha1su0(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha1su0q_u32(host_q32(d), host_q32(n), host_q32(m)));
+}
+
+static inline HOST_SHA1 void host_sha1su1(void *d, void *m)
+{
+    vst1q_u32(d, vsha1su1q_u32(host_q32(d), host_q32(m)));
+}
+
+static inline HOST_SHA256 void host_sha256h(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha256hq_u32(host_q32(d), host_q32(n), host_q32(m)));
+}
+
+static inline HOST_SHA256 void host_sha256h2(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha256h2q_u32(host_q32(d), host_q32(n), host_q32(m)));
+}
+
+static inline HOST_SHA256 void host_sha256su0(void *d, void *m)
+{
+    vst1q_u32(d, vsha256su0q_u32(host_q32(d), host_q32(m)));
+}
+
+static inline HOST_SHA256 void host_sha256su1(void *d, void *n, void *m)
+{
+    vst1q_u32(d, vsha256su1q_u32(host_q32(d), host_q32(n), host_q32(m)));
+}
+
+static inline HOST_SHA512 void host_sha512h(void *d, void *n, void *m)
+{
+    vst1q_u64(d, vsha512hq_u64(host_q64(d), host_q64(n), host_q64(m)));
+}
+
+static inline HOST_SHA512 void host_sha512h2(void *d, void *n, void *m)
+{
+    vst1q_u64(d, vsha512h2q_u64(host_q64(d), host_q64(n), host_q64(m)));
+}
+
+static inline HOST_SHA512 void host_sha512su0(void *d, void *n)
+{
+    vst1q_u64(d, vsha512su0q_u64(host_q64(d), host_q64(n)));
+}
+
+static inline HOST_SHA512 void host_sha512su1(void *d, void *n, void *m)
+{
+    vst1q_u64(d, vsha512su1q_u64(host_q64(d), host_q64(n), host_q64(m)));
+}
+
+#endif /* AArch64 */
+#endif /* TARGET_ARM_CRYPTO_SHA_HOST_H */
