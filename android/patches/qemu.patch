diff --git a/hw/virtio/virtio-vsock-uds.c b/hw/virtio/virtio-vsock-uds.c
new file mode 100644
index 0000000000000000000000000000000000000000..2be384995bd9149a1d49fa88b041b587459bfffe
--- /dev/null
+++ b/hw/virtio/virtio-vsock-uds.c
@@ -0,0 +1,981 @@
+/*
+ * virtio-vsock with the datapath inside QEMU: a hybrid vsock device whose
+ * host side is a Unix socket. /dev/vhost-vsock is not reachable from an
+ * Android app; this needs no kernel vsock at all.
+ *
+ * Host to guest: connect to uds-path and write "CONNECT <port>\n"; on the
+ * guest's accept the device writes "OK <n>\n" and relays the stream. Any
+ * bytes the client wrote after the newline are the start of the stream.
+ * Guest to host: a connection to host port <port> is relayed to the Unix
+ * socket <uds-path>_<port>, if something listens there.
+ *
+ * Credit. Host-to-guest data respects the guest's own window exactly and
+ * nothing else caps it. With credit-request (the default) the device asks
+ * the guest for an update when it has used the window up, because the iOS
+ * driver only sends one unasked when its 512 KiB window is nearly full, and
+ * a host client that has less than that to send then stalls forever (the
+ * same reason a socket buffer of 256 KiB stalls with vhost-vsock). The
+ * credit advertised to the guest is a fixed window, bounded by what the
+ * device can buffer towards a slow client.
+ *
+ * Everything runs in the main loop under the BQL: the virtqueue handlers
+ * and the socket's fd handlers.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include "qapi/error.h"
+#include "hw/qdev-properties.h"
+#include "hw/virtio/virtio-pci.h"
+#include "hw/virtio/virtio-vsock-uds.h"
+#include "migration/vmstate.h"
+#include "qemu/error-report.h"
+#include "qemu/iov.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qemu/sockets.h"
+#include "standard-headers/linux/virtio_ids.h"
+#include "standard-headers/linux/virtio_vsock.h"
+
+/*
+ * 256 entries, as vhost-vsock: the iOS driver assumes page-aligned rings,
+ * and with smaller tables its avail and used rings can overlap.
+ */
+#define VSOCK_UDS_QUEUE_SIZE 256
+
+#define VSOCK_UDS_HOST_CID 2
+#define VSOCK_UDS_HDR_SIZE sizeof(struct virtio_vsock_hdr)
+
+/* What the guest may have in flight towards a host client. */
+#define VSOCK_UDS_BUF_ALLOC (8 * 1024 * 1024)
+/* An unasked credit update once this much has been forwarded. */
+#define VSOCK_UDS_CREDIT_THRESHOLD (VSOCK_UDS_BUF_ALLOC / 2)
+
+#define VSOCK_UDS_CMD_MAX 64
+#define VSOCK_UDS_RX_BATCH 64
+#define VSOCK_UDS_RESPONSE_TIMEOUT_MS 10000
+
+typedef enum {
+    VSOCK_UDS_CONNECT_LINE,     /* host client: reading "CONNECT <port>\n" */
+    VSOCK_UDS_WAIT_RESPONSE,    /* REQUEST sent to the guest */
+    VSOCK_UDS_ESTABLISHED,
+} VsockUdsState;
+
+/* A header-only packet waiting for room in the guest's receive queue. */
+struct VsockUdsCtrl {
+    QTAILQ_ENTRY(VsockUdsCtrl) next;
+    struct virtio_vsock_hdr hdr;
+};
+
+struct VsockUdsConn {
+    QTAILQ_ENTRY(VsockUdsConn) next;
+    VirtIOVsockUds *s;
+    VsockUdsState state;
+    int fd;
+    uint32_t host_port, guest_port;
+    int64_t started_ms;
+
+    char cmd[VSOCK_UDS_CMD_MAX];
+    size_t cmd_len;
+
+    /* Device to guest: the guest's window and what we have sent of it. */
+    uint32_t peer_buf_alloc, peer_fwd_cnt;
+    uint32_t tx_cnt;
+    bool credit_requested;
+
+    /* Guest to device: bytes accepted by the host socket. */
+    uint32_t fwd_cnt, last_fwd_cnt;
+
+    /* Bytes the host socket could not take yet. */
+    uint8_t *pend;
+    size_t pend_off, pend_len, pend_cap;
+
+    bool host_eof;              /* the client's read side reached EOF */
+    bool host_gone;             /* writing to the client failed */
+    bool guest_shut_send;       /* guest will not send more */
+    bool guest_shut_rcv;        /* guest will not receive more */
+    bool shut_wr_done;
+};
+
+static void vsock_uds_conn_update_fds(VsockUdsConn *c);
+static void vsock_uds_conn_read(void *opaque);
+
+static void vsock_uds_trace(VirtIOVsockUds *s, const char *dir,
+                            const struct virtio_vsock_hdr *h)
+{
+    static const char *const ops[] = {
+        "INVALID", "REQUEST", "RESPONSE", "RST", "SHUTDOWN", "RW",
+        "CREDIT_UPDATE", "CREDIT_REQUEST",
+    };
+    uint16_t op = le16_to_cpu(h->op);
+
+    if (s->debug < (op == VIRTIO_VSOCK_OP_RW ? 2 : 1)) {
+        return;
+    }
+    fprintf(stderr, "vsock-uds %s %s %u:%u->%u:%u len=%u flags=%u "
+            "buf_alloc=%u fwd_cnt=%u\n", dir,
+            op < ARRAY_SIZE(ops) ? ops[op] : "?",
+            (unsigned)le64_to_cpu(h->src_cid), le32_to_cpu(h->src_port),
+            (unsigned)le64_to_cpu(h->dst_cid), le32_to_cpu(h->dst_port),
+            le32_to_cpu(h->len), le32_to_cpu(h->flags),
+            le32_to_cpu(h->buf_alloc), le32_to_cpu(h->fwd_cnt));
+}
+
+static void vsock_uds_fill_hdr(VsockUdsConn *c, struct virtio_vsock_hdr *h,
+                               uint16_t op, uint32_t flags, uint32_t len)
+{
+    VirtIOVsockUds *s = c->s;
+
+    h->src_cid = cpu_to_le64(VSOCK_UDS_HOST_CID);
+    h->dst_cid = cpu_to_le64(s->guest_cid);
+    h->src_port = cpu_to_le32(c->host_port);
+    h->dst_port = cpu_to_le32(c->guest_port);
+    h->len = cpu_to_le32(len);
+    h->type = cpu_to_le16(VIRTIO_VSOCK_TYPE_STREAM);
+    h->op = cpu_to_le16(op);
+    h->flags = cpu_to_le32(flags);
+    h->buf_alloc = cpu_to_le32(VSOCK_UDS_BUF_ALLOC);
+    h->fwd_cnt = cpu_to_le32(c->fwd_cnt);
+}
+
+/* Returns false if the guest has no receive buffers left. */
+static bool vsock_uds_flush_ctrl(VirtIOVsockUds *s)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    VsockUdsCtrl *p;
+    bool sent = false, ok = true;
+
+    while ((p = QTAILQ_FIRST(&s->ctrl))) {
+        VirtQueueElement *elem;
+
+        elem = virtqueue_pop(s->rx_vq, sizeof(VirtQueueElement));
+        if (!elem) {
+            s->rx_starved = true;
+            ok = false;
+            break;
+        }
+        if (iov_size(elem->in_sg, elem->in_num) < VSOCK_UDS_HDR_SIZE) {
+            /* A buffer too small for a header: not usable, drop it. */
+            virtqueue_detach_element(s->rx_vq, elem, 0);
+            g_free(elem);
+            continue;
+        }
+        iov_from_buf(elem->in_sg, elem->in_num, 0, &p->hdr, VSOCK_UDS_HDR_SIZE);
+        vsock_uds_trace(s, "to guest", &p->hdr);
+        virtqueue_push(s->rx_vq, elem, VSOCK_UDS_HDR_SIZE);
+        g_free(elem);
+        QTAILQ_REMOVE(&s->ctrl, p, next);
+        g_free(p);
+        sent = true;
+    }
+    if (sent) {
+        virtio_notify(vdev, s->rx_vq);
+    }
+    return ok;
+}
+
+static void vsock_uds_send_ctrl_hdr(VirtIOVsockUds *s,
+                                    const struct virtio_vsock_hdr *h)
+{
+    VsockUdsCtrl *p = g_new(VsockUdsCtrl, 1);
+
+    p->hdr = *h;
+    QTAILQ_INSERT_TAIL(&s->ctrl, p, next);
+    vsock_uds_flush_ctrl(s);
+}
+
+static void vsock_uds_send_ctrl(VsockUdsConn *c, uint16_t op, uint32_t flags)
+{
+    struct virtio_vsock_hdr h;
+
+    vsock_uds_fill_hdr(c, &h, op, flags, 0);
+    vsock_uds_send_ctrl_hdr(c->s, &h);
+}
+
+/* An RST for a packet that matches no connection. */
+static void vsock_uds_send_rst_for(VirtIOVsockUds *s,
+                                   const struct virtio_vsock_hdr *in)
+{
+    struct virtio_vsock_hdr h = {
+        .src_cid = cpu_to_le64(VSOCK_UDS_HOST_CID),
+        .dst_cid = cpu_to_le64(s->guest_cid),
+        .src_port = in->dst_port,
+        .dst_port = in->src_port,
+        .type = cpu_to_le16(VIRTIO_VSOCK_TYPE_STREAM),
+        .op = cpu_to_le16(VIRTIO_VSOCK_OP_RST),
+    };
+
+    vsock_uds_send_ctrl_hdr(s, &h);
+}
+
+static void vsock_uds_conn_free(VsockUdsConn *c)
+{
+    VirtIOVsockUds *s = c->s;
+
+    if (c->fd >= 0) {
+        qemu_set_fd_handler(c->fd, NULL, NULL, NULL);
+        close(c->fd);
+    }
+    QTAILQ_REMOVE(&s->conns, c, next);
+    g_free(c->pend);
+    g_free(c);
+}
+
+static void vsock_uds_conn_reset(VsockUdsConn *c)
+{
+    vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_RST, 0);
+    vsock_uds_conn_free(c);
+}
+
+/*
+ * Both ends are done; whatever was in flight towards the client is gone.
+ * Returns true if the connection was freed.
+ */
+static bool vsock_uds_conn_maybe_finish(VsockUdsConn *c)
+{
+    if (c->pend_len) {
+        return false;
+    }
+    if (c->host_gone ||
+        (c->guest_shut_send && c->guest_shut_rcv) ||
+        (c->guest_shut_send && c->host_eof)) {
+        vsock_uds_conn_reset(c);
+        return true;
+    }
+    return false;
+}
+
+static void vsock_uds_credit_update_if_due(VsockUdsConn *c)
+{
+    if (c->fwd_cnt - c->last_fwd_cnt >= VSOCK_UDS_CREDIT_THRESHOLD) {
+        c->last_fwd_cnt = c->fwd_cnt;
+        vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_CREDIT_UPDATE, 0);
+    }
+}
+
+/* Writes the buffered bytes; c may not outlive a write failure. */
+static void vsock_uds_conn_flush_pend(VsockUdsConn *c)
+{
+    while (c->pend_len) {
+        ssize_t n = send(c->fd, c->pend + c->pend_off, c->pend_len,
+                         MSG_DONTWAIT | MSG_NOSIGNAL);
+
+        if (n < 0) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK) {
+                break;
+            }
+            if (errno == EINTR) {
+                continue;
+            }
+            c->host_gone = true;
+            c->pend_len = 0;
+            break;
+        }
+        c->pend_off += n;
+        c->pend_len -= n;
+        c->fwd_cnt += n;
+    }
+    if (!c->pend_len) {
+        c->pend_off = 0;
+    }
+    if (c->host_gone) {
+        vsock_uds_conn_maybe_finish(c);
+        return;
+    }
+    vsock_uds_credit_update_if_due(c);
+    if (!c->pend_len && c->guest_shut_send && !c->shut_wr_done) {
+        shutdown(c->fd, SHUT_WR);
+        c->shut_wr_done = true;
+        if (vsock_uds_conn_maybe_finish(c)) {
+            return;
+        }
+    }
+    vsock_uds_conn_update_fds(c);
+}
+
+static void vsock_uds_conn_write(void *opaque)
+{
+    vsock_uds_conn_flush_pend(opaque);
+}
+
+static uint32_t vsock_uds_conn_credit(const VsockUdsConn *c)
+{
+    return c->peer_buf_alloc - (c->tx_cnt - c->peer_fwd_cnt);
+}
+
+/*
+ * Registers the handlers the connection needs now. Reading from the client
+ * waits for room towards the guest (rx buffers and credit), so a slow guest
+ * reaches the client as a blocked socket write and not as queued memory.
+ */
+static void vsock_uds_conn_update_fds(VsockUdsConn *c)
+{
+    VirtIOVsockUds *s = c->s;
+    IOHandler *rd = NULL, *wr = NULL;
+
+    switch (c->state) {
+    case VSOCK_UDS_CONNECT_LINE:
+        rd = vsock_uds_conn_read;
+        break;
+    case VSOCK_UDS_WAIT_RESPONSE:
+        break;
+    case VSOCK_UDS_ESTABLISHED:
+        if (!c->host_eof && !c->guest_shut_rcv && !s->rx_starved &&
+            vsock_uds_conn_credit(c) > 0) {
+            rd = vsock_uds_conn_read;
+        }
+        if (c->pend_len) {
+            wr = vsock_uds_conn_write;
+        }
+        break;
+    }
+    qemu_set_fd_handler(c->fd, rd, wr, c);
+}
+
+/* Parses the client's "CONNECT <port>\n" one byte at a time. */
+static void vsock_uds_conn_read_command(VsockUdsConn *c)
+{
+    VirtIOVsockUds *s = c->s;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    char *end;
+    unsigned long port;
+
+    for (;;) {
+        char ch;
+        ssize_t n = recv(c->fd, &ch, 1, MSG_DONTWAIT);
+
+        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            return;
+        }
+        if (n <= 0 && errno != EINTR) {
+            vsock_uds_conn_free(c);
+            return;
+        }
+        if (n <= 0) {
+            continue;
+        }
+        if (ch == '\n') {
+            break;
+        }
+        if (c->cmd_len == sizeof(c->cmd) - 1) {
+            vsock_uds_conn_free(c);
+            return;
+        }
+        c->cmd[c->cmd_len++] = ch;
+    }
+    c->cmd[c->cmd_len] = 0;
+    if (!strncmp(c->cmd, "CONNECT ", 8)) {
+        port = strtoul(c->cmd + 8, &end, 10);
+    } else {
+        end = c->cmd;
+        port = 0;
+    }
+    if (*end || end == c->cmd + 8 || port > UINT32_MAX ||
+        !(vdev->status & VIRTIO_CONFIG_S_DRIVER_OK)) {
+        /* Not a request we can pass on, or no guest driver yet. */
+        vsock_uds_conn_free(c);
+        return;
+    }
+    c->guest_port = port;
+    c->host_port = s->next_host_port++;
+    c->state = VSOCK_UDS_WAIT_RESPONSE;
+    c->started_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    if (!timer_pending(s->timer)) {
+        timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1000);
+    }
+    vsock_uds_conn_update_fds(c);
+    vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_REQUEST, 0);
+}
+
+/* Reads from the client into the guest's rx buffers; returns on no more. */
+static void vsock_uds_conn_pump(VsockUdsConn *c)
+{
+    VirtIOVsockUds *s = c->s;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    bool sent = false;
+    int batch;
+
+    for (batch = 0; batch < VSOCK_UDS_RX_BATCH; batch++) {
+        VirtQueueElement *elem;
+        struct virtio_vsock_hdr h;
+        struct iovec iov[VIRTQUEUE_MAX_SIZE];
+        unsigned iov_cnt;
+        size_t cap;
+        uint32_t credit;
+        ssize_t n;
+
+        if (!vsock_uds_flush_ctrl(s)) {
+            break;
+        }
+        credit = vsock_uds_conn_credit(c);
+        if (credit == 0) {
+            if (s->credit_request && !c->credit_requested) {
+                c->credit_requested = true;
+                vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_CREDIT_REQUEST, 0);
+            }
+            break;
+        }
+
+        elem = virtqueue_pop(s->rx_vq, sizeof(VirtQueueElement));
+        if (!elem) {
+            s->rx_starved = true;
+            break;
+        }
+        cap = iov_size(elem->in_sg, elem->in_num);
+        if (cap <= VSOCK_UDS_HDR_SIZE) {
+            virtqueue_detach_element(s->rx_vq, elem, 0);
+            g_free(elem);
+            continue;
+        }
+        cap = MIN(cap - VSOCK_UDS_HDR_SIZE, credit);
+        iov_cnt = iov_copy(iov, ARRAY_SIZE(iov), elem->in_sg, elem->in_num,
+                           VSOCK_UDS_HDR_SIZE, cap);
+        n = readv(c->fd, iov, iov_cnt);
+        if (n <= 0) {
+            virtqueue_unpop(s->rx_vq, elem, 0);
+            g_free(elem);
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK ||
+                          errno == EINTR)) {
+                break;
+            }
+            /*
+             * The client closed its write side, or is gone: no more data
+             * towards the guest. Bytes already buffered towards the client
+             * still go until a write fails.
+             */
+            c->host_eof = true;
+            vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_SHUTDOWN,
+                                VIRTIO_VSOCK_SHUTDOWN_SEND);
+            if (!vsock_uds_conn_maybe_finish(c)) {
+                /* Stops the read handler, which EOF would keep firing. */
+                vsock_uds_conn_update_fds(c);
+            }
+            goto out_notify;
+        }
+        vsock_uds_fill_hdr(c, &h, VIRTIO_VSOCK_OP_RW, 0, n);
+        vsock_uds_trace(s, "to guest", &h);
+        iov_from_buf(elem->in_sg, elem->in_num, 0, &h, sizeof(h));
+        virtqueue_push(s->rx_vq, elem, VSOCK_UDS_HDR_SIZE + n);
+        g_free(elem);
+        c->tx_cnt += n;
+        sent = true;
+        if ((size_t)n < cap) {
+            /* The socket has nothing more just now. */
+            break;
+        }
+    }
+    vsock_uds_conn_update_fds(c);
+
+out_notify:
+    if (sent) {
+        virtio_notify(vdev, s->rx_vq);
+    }
+}
+
+static void vsock_uds_conn_read(void *opaque)
+{
+    VsockUdsConn *c = opaque;
+
+    if (c->state == VSOCK_UDS_CONNECT_LINE) {
+        vsock_uds_conn_read_command(c);
+    } else {
+        vsock_uds_conn_pump(c);
+    }
+}
+
+/* The guest has given us receive buffers: restart everything we stopped. */
+static void vsock_uds_rx_restart(VirtIOVsockUds *s)
+{
+    VsockUdsConn *c, *tmp;
+
+    s->rx_starved = false;
+    if (!vsock_uds_flush_ctrl(s)) {
+        return;
+    }
+    QTAILQ_FOREACH_SAFE(c, &s->conns, next, tmp) {
+        vsock_uds_conn_update_fds(c);
+    }
+}
+
+static void vsock_uds_accept(void *opaque)
+{
+    VirtIOVsockUds *s = opaque;
+    VsockUdsConn *c;
+    int fd;
+
+    fd = qemu_accept(s->listen_fd, NULL, NULL);
+    if (fd < 0) {
+        return;
+    }
+    qemu_set_blocking(fd, false, &error_abort);
+    c = g_new0(VsockUdsConn, 1);
+    c->s = s;
+    c->fd = fd;
+    c->state = VSOCK_UDS_CONNECT_LINE;
+    QTAILQ_INSERT_TAIL(&s->conns, c, next);
+    vsock_uds_conn_update_fds(c);
+}
+
+static VsockUdsConn *vsock_uds_find(VirtIOVsockUds *s, uint32_t host_port,
+                                    uint32_t guest_port)
+{
+    VsockUdsConn *c;
+
+    QTAILQ_FOREACH(c, &s->conns, next) {
+        if (c->state != VSOCK_UDS_CONNECT_LINE && c->host_port == host_port &&
+            c->guest_port == guest_port) {
+            return c;
+        }
+    }
+    return NULL;
+}
+
+/* A guest connection to a host port: <uds-path>_<port>, if there is one. */
+static void vsock_uds_guest_connect(VirtIOVsockUds *s,
+                                    const struct virtio_vsock_hdr *h)
+{
+    g_autofree char *path = g_strdup_printf("%s_%u", s->uds_path,
+                                            le32_to_cpu(h->dst_port));
+    Error *err = NULL;
+    VsockUdsConn *c;
+    int fd;
+
+    fd = unix_connect(path, &err);
+    if (fd < 0) {
+        error_free(err);
+        vsock_uds_send_rst_for(s, h);
+        return;
+    }
+    qemu_set_blocking(fd, false, &error_abort);
+
+    c = g_new0(VsockUdsConn, 1);
+    c->s = s;
+    c->fd = fd;
+    c->state = VSOCK_UDS_ESTABLISHED;
+    c->host_port = le32_to_cpu(h->dst_port);
+    c->guest_port = le32_to_cpu(h->src_port);
+    c->peer_buf_alloc = le32_to_cpu(h->buf_alloc);
+    c->peer_fwd_cnt = le32_to_cpu(h->fwd_cnt);
+    QTAILQ_INSERT_TAIL(&s->conns, c, next);
+    vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_RESPONSE, 0);
+    vsock_uds_conn_update_fds(c);
+}
+
+static void vsock_uds_rw_from_guest(VsockUdsConn *c,
+                                    VirtQueueElement *elem, uint32_t len)
+{
+    size_t avail = iov_size(elem->out_sg, elem->out_num);
+    size_t off = 0;
+
+    if (avail < VSOCK_UDS_HDR_SIZE + (size_t)len) {
+        /* Advertised more than it provided. */
+        vsock_uds_conn_reset(c);
+        return;
+    }
+
+    if (!c->pend_len) {
+        struct iovec iov[VIRTQUEUE_MAX_SIZE];
+        unsigned cnt = iov_copy(iov, ARRAY_SIZE(iov), elem->out_sg,
+                                elem->out_num, VSOCK_UDS_HDR_SIZE, len);
+        struct msghdr msg = { .msg_iov = iov, .msg_iovlen = cnt };
+        ssize_t n;
+
+        do {
+            n = sendmsg(c->fd, &msg, MSG_DONTWAIT | MSG_NOSIGNAL);
+        } while (n < 0 && errno == EINTR);
+        if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+            c->host_gone = true;
+            vsock_uds_conn_maybe_finish(c);
+            return;
+        }
+        if (n > 0) {
+            off = n;
+            c->fwd_cnt += n;
+        }
+    }
+
+    if (off < len) {
+        size_t rest = len - off;
+
+        if (c->pend_len + rest > VSOCK_UDS_BUF_ALLOC) {
+            /* Beyond the credit we advertised. */
+            vsock_uds_conn_reset(c);
+            return;
+        }
+        if (c->pend_off + c->pend_len + rest > c->pend_cap) {
+            size_t want = c->pend_len + rest;
+
+            if (want > c->pend_cap) {
+                c->pend_cap = MIN(MAX(want, c->pend_cap * 2),
+                                  VSOCK_UDS_BUF_ALLOC);
+                c->pend = g_realloc(c->pend, c->pend_cap);
+            }
+            memmove(c->pend, c->pend + c->pend_off, c->pend_len);
+            c->pend_off = 0;
+        }
+        iov_to_buf(elem->out_sg, elem->out_num, VSOCK_UDS_HDR_SIZE + off,
+                   c->pend + c->pend_off + c->pend_len, rest);
+        c->pend_len += rest;
+    }
+    vsock_uds_credit_update_if_due(c);
+    vsock_uds_conn_update_fds(c);
+}
+
+static void vsock_uds_handle_packet(VirtIOVsockUds *s, VirtQueueElement *elem)
+{
+    struct virtio_vsock_hdr h;
+    VsockUdsConn *c;
+    uint16_t op, type;
+    uint32_t len, flags;
+
+    if (iov_to_buf(elem->out_sg, elem->out_num, 0, &h, sizeof(h)) != sizeof(h)) {
+        return;
+    }
+    vsock_uds_trace(s, "from guest", &h);
+    op = le16_to_cpu(h.op);
+    type = le16_to_cpu(h.type);
+    len = le32_to_cpu(h.len);
+    flags = le32_to_cpu(h.flags);
+
+    if (le64_to_cpu(h.dst_cid) != VSOCK_UDS_HOST_CID) {
+        return;
+    }
+    if (type != VIRTIO_VSOCK_TYPE_STREAM) {
+        vsock_uds_send_rst_for(s, &h);
+        return;
+    }
+
+    c = vsock_uds_find(s, le32_to_cpu(h.dst_port), le32_to_cpu(h.src_port));
+    if (!c) {
+        if (op == VIRTIO_VSOCK_OP_REQUEST) {
+            vsock_uds_guest_connect(s, &h);
+        } else if (op != VIRTIO_VSOCK_OP_RST) {
+            vsock_uds_send_rst_for(s, &h);
+        }
+        return;
+    }
+
+    /* Every packet carries the sender's credit. */
+    c->peer_buf_alloc = le32_to_cpu(h.buf_alloc);
+    c->peer_fwd_cnt = le32_to_cpu(h.fwd_cnt);
+    c->credit_requested = false;
+
+    switch (op) {
+    case VIRTIO_VSOCK_OP_RESPONSE:
+        if (c->state == VSOCK_UDS_WAIT_RESPONSE) {
+            g_autofree char *ok = g_strdup_printf("OK %u\n", c->host_port);
+            size_t ok_len = strlen(ok);
+            ssize_t n;
+
+            /* The socket buffer is empty; this cannot block or be short. */
+            do {
+                n = send(c->fd, ok, ok_len, MSG_DONTWAIT | MSG_NOSIGNAL);
+            } while (n < 0 && errno == EINTR);
+            if (n != (ssize_t)ok_len) {
+                vsock_uds_conn_reset(c);
+                return;
+            }
+            c->state = VSOCK_UDS_ESTABLISHED;
+            vsock_uds_conn_update_fds(c);
+        }
+        break;
+
+    case VIRTIO_VSOCK_OP_RST:
+        vsock_uds_conn_free(c);
+        break;
+
+    case VIRTIO_VSOCK_OP_SHUTDOWN:
+        c->guest_shut_rcv |= !!(flags & VIRTIO_VSOCK_SHUTDOWN_RCV);
+        c->guest_shut_send |= !!(flags & VIRTIO_VSOCK_SHUTDOWN_SEND);
+        if (c->guest_shut_send && !c->pend_len && !c->shut_wr_done) {
+            shutdown(c->fd, SHUT_WR);
+            c->shut_wr_done = true;
+        }
+        if (!vsock_uds_conn_maybe_finish(c)) {
+            vsock_uds_conn_update_fds(c);
+        }
+        break;
+
+    case VIRTIO_VSOCK_OP_RW:
+        if (c->state != VSOCK_UDS_ESTABLISHED) {
+            vsock_uds_conn_reset(c);
+            break;
+        }
+        vsock_uds_rw_from_guest(c, elem, len);
+        break;
+
+    case VIRTIO_VSOCK_OP_CREDIT_UPDATE:
+        vsock_uds_conn_update_fds(c);
+        break;
+
+    case VIRTIO_VSOCK_OP_CREDIT_REQUEST:
+        vsock_uds_send_ctrl(c, VIRTIO_VSOCK_OP_CREDIT_UPDATE, 0);
+        vsock_uds_conn_update_fds(c);
+        break;
+
+    case VIRTIO_VSOCK_OP_REQUEST:
+        /* Already connected: not valid. */
+        vsock_uds_conn_reset(c);
+        break;
+
+    default:
+        vsock_uds_conn_reset(c);
+        break;
+    }
+}
+
+static void vsock_uds_handle_tx(VirtIODevice *vdev, VirtQueue *vq)
+{
+    VirtIOVsockUds *s = VIRTIO_VSOCK_UDS(vdev);
+    VirtQueueElement *elem;
+    bool done = false;
+
+    while ((elem = virtqueue_pop(vq, sizeof(VirtQueueElement)))) {
+        vsock_uds_handle_packet(s, elem);
+        virtqueue_push(vq, elem, 0);
+        g_free(elem);
+        done = true;
+    }
+    if (done) {
+        virtio_notify(vdev, vq);
+    }
+}
+
+static void vsock_uds_handle_rx(VirtIODevice *vdev, VirtQueue *vq)
+{
+    vsock_uds_rx_restart(VIRTIO_VSOCK_UDS(vdev));
+}
+
+static void vsock_uds_handle_event(VirtIODevice *vdev, VirtQueue *vq)
+{
+    /* The event queue only carries a transport reset, after a migration. */
+}
+
+/* Drops a host client's connect that the guest never answered. */
+static void vsock_uds_timer(void *opaque)
+{
+    VirtIOVsockUds *s = opaque;
+    VsockUdsConn *c, *tmp;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    bool waiting = false;
+
+    QTAILQ_FOREACH_SAFE(c, &s->conns, next, tmp) {
+        if (c->state != VSOCK_UDS_WAIT_RESPONSE) {
+            continue;
+        }
+        if (now - c->started_ms > VSOCK_UDS_RESPONSE_TIMEOUT_MS) {
+            vsock_uds_conn_free(c);
+        } else {
+            waiting = true;
+        }
+    }
+    if (waiting) {
+        timer_mod(s->timer, now + 1000);
+    }
+}
+
+static void vsock_uds_close_all(VirtIOVsockUds *s)
+{
+    VsockUdsConn *c;
+    VsockUdsCtrl *p;
+
+    while ((c = QTAILQ_FIRST(&s->conns))) {
+        vsock_uds_conn_free(c);
+    }
+    while ((p = QTAILQ_FIRST(&s->ctrl))) {
+        QTAILQ_REMOVE(&s->ctrl, p, next);
+        g_free(p);
+    }
+    s->rx_starved = false;
+}
+
+static void vsock_uds_get_config(VirtIODevice *vdev, uint8_t *config)
+{
+    VirtIOVsockUds *s = VIRTIO_VSOCK_UDS(vdev);
+    struct virtio_vsock_config cfg = {
+        .guest_cid = cpu_to_le64(s->guest_cid),
+    };
+
+    memcpy(config, &cfg, sizeof(cfg));
+}
+
+static uint64_t vsock_uds_get_features(VirtIODevice *vdev, uint64_t features,
+                                       Error **errp)
+{
+    return features;
+}
+
+static void vsock_uds_reset(VirtIODevice *vdev)
+{
+    vsock_uds_close_all(VIRTIO_VSOCK_UDS(vdev));
+}
+
+static int vsock_uds_set_status(VirtIODevice *vdev, uint8_t status)
+{
+    /* The driver went away (including a guest driver reset): start over. */
+    if (!(status & VIRTIO_CONFIG_S_DRIVER_OK)) {
+        vsock_uds_close_all(VIRTIO_VSOCK_UDS(vdev));
+    }
+    return 0;
+}
+
+static void vsock_uds_realize(DeviceState *dev, Error **errp)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    VirtIOVsockUds *s = VIRTIO_VSOCK_UDS(dev);
+    const char *debug;
+
+    if (s->guest_cid <= VSOCK_UDS_HOST_CID || s->guest_cid >= UINT32_MAX) {
+        error_setg(errp, "guest-cid must be between 3 and 2^32-2");
+        return;
+    }
+    if (!s->uds_path) {
+        error_setg(errp, "uds-path is required");
+        return;
+    }
+
+    s->listen_fd = unix_listen(s->uds_path, errp);
+    if (s->listen_fd < 0) {
+        return;
+    }
+
+    /* Local ports for host-initiated connections, as Firecracker's. */
+    s->next_host_port = 1u << 30;
+    debug = getenv("VPHONE_VSOCK_DEBUG");
+    s->debug = debug ? atoi(debug) : 0;
+    QTAILQ_INIT(&s->conns);
+    QTAILQ_INIT(&s->ctrl);
+    s->timer = timer_new_ms(QEMU_CLOCK_REALTIME, vsock_uds_timer, s);
+
+    virtio_init(vdev, VIRTIO_ID_VSOCK, sizeof(struct virtio_vsock_config));
+    s->rx_vq = virtio_add_queue(vdev, VSOCK_UDS_QUEUE_SIZE, vsock_uds_handle_rx);
+    s->tx_vq = virtio_add_queue(vdev, VSOCK_UDS_QUEUE_SIZE, vsock_uds_handle_tx);
+    s->event_vq = virtio_add_queue(vdev, VSOCK_UDS_QUEUE_SIZE,
+                                   vsock_uds_handle_event);
+
+    qemu_set_fd_handler(s->listen_fd, vsock_uds_accept, NULL, s);
+}
+
+static void vsock_uds_unrealize(DeviceState *dev)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    VirtIOVsockUds *s = VIRTIO_VSOCK_UDS(dev);
+
+    vsock_uds_close_all(s);
+    if (s->listen_fd >= 0) {
+        qemu_set_fd_handler(s->listen_fd, NULL, NULL, NULL);
