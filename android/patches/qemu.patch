+
+/*
+ * The same conditions on NEON, with one more: FPCR.FZ must be clear (under
+ * native FP, FPCR is the guest's), or a difference of two normals that is
+ * denormal would be flushed to a zero the checks below would pass. The
+ * checks are integer compares on the bit patterns, which raise nothing; the
+ * FP flags the arithmetic itself raised are undone whether or not a lane
+ * failed (the guest's Inexact, if the vector is taken, is already in the
+ * status).
+ */
+enum { VF32_ADD, VF32_SUB, VF32_MUL, VF32_FMA, VF32_FMS };
+
+static int vf32_mode = -1;      /* -1 unknown, 0 off, 1 on */
+
+static int vf32_init(void)
+{
+    const char *e = getenv("VPHONE_FAST_F32");
+    int mode = !(e && *e == '0');
+
+    qatomic_set(&vf32_mode, mode);
+    return mode;
+}
+
+/* Lanes that are zero or normal: |v| == 0, or minnorm <= |v| <= maxnorm. */
+static inline uint32x4_t vf32_zon(uint32x4_t v, uint32x4_t abs_mask)
+{
+    uint32x4_t a = vandq_u32(v, abs_mask);
+    uint32x4_t normal = vandq_u32(vcgeq_u32(a, vdupq_n_u32(0x00800000)),
+                                  vcleq_u32(a, vdupq_n_u32(0x7f7fffff)));
+
+    return vorrq_u32(normal, vceqq_u32(a, vdupq_n_u32(0)));
+}
+
+/* Lanes whose result passes (see above); zero_ok marks the exact zeros. */
+static inline uint32x4_t vf32_result_ok(uint32x4_t r, uint32x4_t zero_ok,
+                                        uint32x4_t abs_mask)
+{
+    uint32x4_t a = vandq_u32(r, abs_mask);
+    uint32x4_t big = vandq_u32(vcgtq_u32(a, vdupq_n_u32(0x00800000)),
+                               vcleq_u32(a, vdupq_n_u32(0x7f7fffff)));
+
+    return vorrq_u32(big, vandq_u32(vceqq_u32(a, vdupq_n_u32(0)), zero_ok));
