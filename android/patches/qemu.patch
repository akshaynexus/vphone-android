+/*
+ * virtio-vsock with the datapath inside QEMU and a Unix socket host side
+ * (hybrid vsock, as Firecracker's): a host client connects to the socket and
+ * writes "CONNECT <port>\n"; once the guest accepts, it reads "OK <n>\n" and
+ * the stream is a vsock stream to the guest's <port>. A guest connection to
+ * a host port <port> is a connection to the Unix socket <uds-path>_<port>.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_VIRTIO_VSOCK_UDS_H
