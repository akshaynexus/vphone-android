+#if TCG_TARGET_HAS_fp
+/*
+ * vphone-linux: the TCG floating-point opcodes (tcg-opc.h) as A64 FP and
+ * Advanced SIMD instructions. Each one is the instruction the guest asked
+ * for, run with the host's FPCR following the guest's (target/arm/tcg/
+ * host-fpcr.h), so results and FPSR flags are the architecture's without
+ * the fallbacks an x86 host needs. See tcg_fp_arm_exact().
+ *
+ * The scalar arithmetic forms are "data-processing (FP)", which take the
+ * half-precision forms from FEAT_FP16; the scalar/vector advanced-SIMD
+ * three-same and two-register-misc forms get theirs as noted below.
+ */
+static bool have_fp16;
+
+static unsigned tcg_fp_ftype(unsigned esz)
+{
+    return esz == MO_16 ? 3 : esz == MO_64 ? 1 : 0;
+}
+
+/* The operand size of an FP op: scalar type, or vector element size. */
+static unsigned tcg_fp_esz(TCGType type, unsigned vece)
+{
+    switch (type) {
+    case TCG_TYPE_F16:
+        return MO_16;
+    case TCG_TYPE_F32:
+        return MO_32;
+    case TCG_TYPE_F64:
+        return MO_64;
+    default:
+        return vece;
+    }
+}
+
+static bool tcg_fp_is_vector(TCGType type)
+{
+    return type == TCG_TYPE_V64 || type == TCG_TYPE_V128;
+}
+
+/* FMADD, ... : 3-source */
+static void tcg_out_fp_3src(TCGContext *s, unsigned esz, bool sub,
+                            TCGReg rd, TCGReg rn, TCGReg rm, TCGReg ra)
+{
+    tcg_out32(s, 0x1f000000 | tcg_fp_ftype(esz) << 22 | (rm & 0x1f) << 16 |
+                 sub << 15 | (ra & 0x1f) << 10 | (rn & 0x1f) << 5 |
+                 (rd & 0x1f));
+}
+
+/* FMUL, ... : data-processing, 2 sources (opcode in bits 15:12) */
+static void tcg_out_fp_s2(TCGContext *s, unsigned op, unsigned esz,
+                          TCGReg rd, TCGReg rn, TCGReg rm)
+{
+    tcg_out32(s, 0x1e200800 | tcg_fp_ftype(esz) << 22 | (rm & 0x1f) << 16 |
+                 op << 12 | (rn & 0x1f) << 5 | (rd & 0x1f));
+}
+
+/* FABS, ... : data-processing, 1 source (opcode in bits 20:15) */
+static void tcg_out_fp_s1(TCGContext *s, unsigned op, unsigned esz,
+                          TCGReg rd, TCGReg rn)
+{
+    tcg_out32(s, 0x1e204000 | tcg_fp_ftype(esz) << 22 | op << 15 |
+                 (rn & 0x1f) << 5 | (rd & 0x1f));
+}
+
+/*
+ * Advanced SIMD three-same (FP), given by its 32-bit-vector encoding. The
+ * scalar form sets bits 30:28 (U stays); half precision is the FP16 group:
+ * bit 22 set, bits 21 and 15:14 clear (a in bit 23 and U as they were);
+ * double sets sz (bit 22).
+ */
+static void tcg_out_fp_3same(TCGContext *s, uint32_t insn, bool scalar,
+                             bool q, unsigned esz,
+                             TCGReg rd, TCGReg rn, TCGReg rm)
+{
+    if (esz == MO_16) {
+        insn = (insn & ~(1u << 21 | 3u << 14)) | 1u << 22;
+    } else if (esz == MO_64) {
+        insn |= 1u << 22;
+    }
+    insn |= scalar ? 0x50000000u : (uint32_t)q << 30;
+    tcg_out32(s, insn | (rm & 0x1f) << 16 | (rn & 0x1f) << 5 | (rd & 0x1f));
+}
+
+/*
+ * Advanced SIMD two-register misc (FP), given by its 32-bit-vector
+ * encoding; half precision (FP16) ors in 0x00580000, double sets sz.
+ */
+static void tcg_out_fp_2misc(TCGContext *s, uint32_t insn, bool scalar,
+                             bool q, unsigned esz, TCGReg rd, TCGReg rn)
+{
+    if (esz == MO_16) {
+        insn |= 0x00580000u;
+    } else if (esz == MO_64) {
+        insn |= 1u << 22;
+    }
+    insn |= scalar ? 0x50000000u : (uint32_t)q << 30;
+    tcg_out32(s, insn | (rn & 0x1f) << 5 | (rd & 0x1f));
+}
+
+/* SCVTF/UCVTF/FCVTZS/FCVTZU (fixed-point), scalar or vector. */
+static void tcg_out_fp_fixed(TCGContext *s, uint32_t insn, bool scalar,
+                             bool q, unsigned esz, unsigned fbits,
+                             TCGReg rd, TCGReg rn)
+{
+    insn |= ((16u << esz) - fbits) << 16;
+    insn |= scalar ? 0x50000000u : (uint32_t)q << 30;
+    tcg_out32(s, insn | (rn & 0x1f) << 5 | (rd & 0x1f));
+}
+
+/* rint: FRINTN/M/P/Z/A/I/X, opcode for scalar, encoding for vector. */
+static void tcg_out_fp_rint(TCGContext *s, TCGArg round, bool vec, bool q,
+                            unsigned esz, TCGReg rd, TCGReg rn)
+{
+    static const uint8_t s_op[] = {
+        [TCG_FP_ROUND_NEAREST_EVEN]  = 8,  /* 001000 */
+        [TCG_FP_ROUND_UP]            = 9,  /* 001001 */
+        [TCG_FP_ROUND_DOWN]          = 10, /* 001010 */
+        [TCG_FP_ROUND_TO_ZERO]       = 11, /* 001011 */
+        [TCG_FP_ROUND_TIES_AWAY]     = 12, /* 001100 */
+        [TCG_FP_ROUND_CURRENT]       = 15, /* 001111 FRINTI */
+        [TCG_FP_ROUND_CURRENT_EXACT] = 14, /* 001110 FRINTX */
+    };
+    static const uint32_t v_op[] = {
+        [TCG_FP_ROUND_NEAREST_EVEN]  = 0x0e218800,
+        [TCG_FP_ROUND_UP]            = 0x0ea18800,
+        [TCG_FP_ROUND_DOWN]          = 0x0e219800,
+        [TCG_FP_ROUND_TO_ZERO]       = 0x0ea19800,
+        [TCG_FP_ROUND_TIES_AWAY]     = 0x2e218800,
+        [TCG_FP_ROUND_CURRENT]       = 0x2ea19800,
+        [TCG_FP_ROUND_CURRENT_EXACT] = 0x2e219800,
+    };
+
+    if (vec) {
+        tcg_out_fp_2misc(s, v_op[round], false, q, esz, rd, rn);
+    } else {
+        tcg_out_fp_s1(s, s_op[round], esz, rd, rn);
+    }
+}
+
+/* fp -> int, same width, in FP/SIMD registers: vector or scalar. */
+static void tcg_out_fp_cvt_same(TCGContext *s, bool uns, TCGArg round,
+                                unsigned fbits, bool vec, bool q,
+                                unsigned esz, TCGReg rd, TCGReg rn)
+{
+    /* FCVTNS, FCVTMS, FCVTPS, FCVTZS, FCVTAS; the unsigned ones set U. */
+    static const uint32_t op[] = {
+        [TCG_FP_ROUND_NEAREST_EVEN] = 0x0e21a800,
+        [TCG_FP_ROUND_DOWN]         = 0x0e21b800,
+        [TCG_FP_ROUND_UP]           = 0x0ea1a800,
+        [TCG_FP_ROUND_TO_ZERO]      = 0x0ea1b800,
+        [TCG_FP_ROUND_TIES_AWAY]    = 0x0e21c800,
+    };
+
+    if (fbits) {
+        tcg_debug_assert(round == TCG_FP_ROUND_TO_ZERO);
+        tcg_out_fp_fixed(s, uns ? 0x2f00fc00 : 0x0f00fc00, !vec, q, esz,
+                         fbits, rd, rn);
+    } else {
+        tcg_out_fp_2misc(s, op[round] | (uint32_t)uns << 29, !vec, q, esz,
+                         rd, rn);
+    }
+}
+
+bool tcg_can_emit_fp_op(TCGOpcode opc, TCGType type, unsigned vece)
+{
+    switch (opc) {
+    case INDEX_op_cvtn_fp:
+    case INDEX_op_cvtl_fp:
+        /* vece is the narrow size. */
+        return type == TCG_TYPE_V128 && (vece == MO_16 || vece == MO_32);
+    case INDEX_op_cvtxn_fp:
+        return type == TCG_TYPE_V128 && vece == MO_32;
+    case INDEX_op_cvt_f2i_s:
+    case INDEX_op_cvt_f2i_u:
+        /* type is the integer type; see tcg_can_emit_fp_cvt(). */
+        return type == TCG_TYPE_I32 || type == TCG_TYPE_I64;
+    case INDEX_op_cvt_fp:
+        /* FCVT is in the base FP set, half precision included. */
+        return type == TCG_TYPE_F16 || type == TCG_TYPE_F32 ||
+               type == TCG_TYPE_F64;
+    case INDEX_op_fpchk_fp:
+        /* Only for a host that is not tcg_fp_arm_exact(). */
+        return false;
+    default:
+        break;
+    }
+
+    if (tcg_fp_is_vector(type)) {
+        /* Advanced SIMD has .4h/.8h, .2s/.4s and .2d, and no .1d. */
+        if (vece < MO_16 || vece > MO_64 ||
+            (vece == MO_16 && !have_fp16) ||
+            (vece == MO_64 && type == TCG_TYPE_V64)) {
+            return false;
+        }
+    } else if (type == TCG_TYPE_F16) {
+        if (!have_fp16) {
+            return false;
+        }
+    } else if (type != TCG_TYPE_F32 && type != TCG_TYPE_F64) {
+        return false;
+    }
+
+    switch (opc) {
+    case INDEX_op_add_fp:
+    case INDEX_op_sub_fp:
+    case INDEX_op_mul_fp:
+    case INDEX_op_div_fp:
+    case INDEX_op_sqrt_fp:
+    case INDEX_op_rint_fp:
+    case INDEX_op_min_fp:
+    case INDEX_op_max_fp:
+    case INDEX_op_minnum_fp:
+    case INDEX_op_maxnum_fp:
+    case INDEX_op_neg_fp:
+    case INDEX_op_abs_fp:
+    case INDEX_op_mulx_fp:
+    case INDEX_op_recps_fp:
+    case INDEX_op_rsqrts_fp:
+    case INDEX_op_recpe_fp:
+    case INDEX_op_rsqrte_fp:
+    case INDEX_op_fma_fp:
+    case INDEX_op_fms_fp:
+    case INDEX_op_cmp_fp:
+    case INDEX_op_cvt_s_fp:
+    case INDEX_op_cvt_u_fp:
+    case INDEX_op_cvt_fp_s:
+    case INDEX_op_cvt_fp_u:
+        return true;
+    case INDEX_op_addp_fp:
+    case INDEX_op_maxp_fp:
+    case INDEX_op_minp_fp:
+    case INDEX_op_maxnump_fp:
+    case INDEX_op_minnump_fp:
+        return tcg_fp_is_vector(type);
+    case INDEX_op_recpx_fp:
+    case INDEX_op_fcmp_fp:
+    case INDEX_op_cvt_s_i2f:
+    case INDEX_op_cvt_u_i2f:
+        return !tcg_fp_is_vector(type);
+    default:
+        return false;
+    }
+}
+
+bool tcg_can_emit_fp_cvt(TCGOpcode opc, TCGType type, unsigned other,
+                         TCGArg round, TCGArg fbits)
+{
+    bool fp = type == TCG_TYPE_F16 || type == TCG_TYPE_F32 ||
+              type == TCG_TYPE_F64;
+    bool int_other = other == TCG_TYPE_I32 || other == TCG_TYPE_I64;
+    unsigned esz = tcg_fp_esz(type, other);
+    unsigned width = 8u << esz;
+
+    switch (opc) {
+    case INDEX_op_cvt_fp:
+        return fbits == 0 && fp && other != type &&
+               (other == TCG_TYPE_F16 || other == TCG_TYPE_F32 ||
+                other == TCG_TYPE_F64);
+    case INDEX_op_rint_fp:
+        return fbits == 0 && round <= TCG_FP_ROUND_CURRENT_EXACT &&
+               tcg_can_emit_fp_op(opc, type, other);
+    case INDEX_op_cvt_s_fp:
+    case INDEX_op_cvt_u_fp:
+        return tcg_can_emit_fp_op(opc, type, other) && fbits <= width;
+    case INDEX_op_cvt_fp_s:
+    case INDEX_op_cvt_fp_u:
+        /* The fixed-point forms only truncate. */
+        return tcg_can_emit_fp_op(opc, type, other) && fbits <= width &&
+               round <= TCG_FP_ROUND_TIES_AWAY &&
+               (fbits == 0 || round == TCG_FP_ROUND_TO_ZERO);
+    case INDEX_op_cvt_s_i2f:
+    case INDEX_op_cvt_u_i2f:
+        return fp && int_other && (type != TCG_TYPE_F16 || have_fp16) &&
+               fbits <= (other == TCG_TYPE_I64 ? 64 : 32);
+    case INDEX_op_cvt_f2i_s:
+    case INDEX_op_cvt_f2i_u:
+        return fp && int_other && (type != TCG_TYPE_F16 || have_fp16) &&
+               round <= TCG_FP_ROUND_TIES_AWAY &&
+               fbits <= (other == TCG_TYPE_I64 ? 64 : 32) &&
+               (fbits == 0 || round == TCG_FP_ROUND_TO_ZERO);
+    default:
+        return false;
+    }
+}
+
+static void tcg_out_fp_op(TCGContext *s, TCGOpcode opc, TCGType type,
+                          unsigned vece, const TCGArg args[TCG_MAX_OP_ARGS],
+                          const int const_args[TCG_MAX_OP_ARGS])
+{
+    TCGReg a0 = args[0], a1 = args[1], a2 = args[2];
+    bool vec = tcg_fp_is_vector(type);
+    bool q = type == TCG_TYPE_V128;
+    unsigned esz = tcg_fp_esz(type, vece);
+    uint32_t insn;
+
+    switch (opc) {
+    case INDEX_op_add_fp:
+        if (vec) {
+            tcg_out_fp_3same(s, 0x0e20d400, false, q, esz, a0, a1, a2);
+        } else {
+            tcg_out_fp_s2(s, 2, esz, a0, a1, a2);
+        }
+        break;
+    case INDEX_op_sub_fp:
+        if (vec) {
+            tcg_out_fp_3same(s, 0x0ea0d400, false, q, esz, a0, a1, a2);
+        } else {
+            tcg_out_fp_s2(s, 3, esz, a0, a1, a2);
+        }
+        break;
+    case INDEX_op_mul_fp:
+        if (vec) {
