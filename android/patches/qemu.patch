diff --git a/util/coroutine-aarch64.c b/util/coroutine-aarch64.c
new file mode 100644
index 0000000000000000000000000000000000000000..0f2fa665ef2ef572bf711d9586758f5fa5a01466
--- /dev/null
+++ b/util/coroutine-aarch64.c
@@ -0,0 +1,177 @@
+/*
+ * Coroutines for AArch64 Android, by switching stacks directly
+ *
+ * Bionic has no makecontext(), which leaves the sigaltstack backend: it starts
+ * each coroutine from a signal handler and switches with sigsetjmp() and
+ * siglongjmp(). Bionic signs the return address in the jmp_buf with
+ * pointer authentication, and QEMU moves coroutines between threads, so the
+ * authentication at the end of siglongjmp() can fail and kill the process
+ * with SIGILL where the CPU traps on it. Here nothing is signed, a switch is
+ * one function call without a system call, and starting a coroutine needs no
+ * signal.
+ *
+ * x18 is left alone: it is the thread's shadow call stack, which libc's
+ * frames use, and those are balanced before any coroutine switch.
+ *
+ * SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/coroutine_int.h"
+#include "qemu/coroutine-tls.h"
+
+typedef struct {
+    Coroutine base;
+    void *stack;
+    size_t stack_size;
+    /* The stack pointer of a coroutine that is not running */
+    void *sp;
+} CoroutineAArch64;
+
+QEMU_DEFINE_STATIC_CO_TLS(Coroutine *, current);
+QEMU_DEFINE_STATIC_CO_TLS(CoroutineAArch64, leader);
+
+/* What coroutine_aarch64_switch() pushes, in order. */
+enum {
+    FRAME_X19,
+    FRAME_X20,
+    FRAME_X29 = 10,
+    FRAME_X30,
+    FRAME_WORDS = 20,
+};
+
+/* Saves this context to *save_sp, resumes load_sp, and returns its action. */
+uintptr_t coroutine_aarch64_switch(void **save_sp, void *load_sp,
+                                   uintptr_t action);
+/* Where a new coroutine starts, with its CoroutineAArch64 in x19. */
+void coroutine_aarch64_start(void);
+
+__asm__(
+    ".text\n"
+    ".balign 4\n"
+    ".hidden coroutine_aarch64_switch\n"
+    ".type coroutine_aarch64_switch, %function\n"
+    "coroutine_aarch64_switch:\n"
+    "    .cfi_startproc\n"
+    "    sub sp, sp, #160\n"
+    "    .cfi_adjust_cfa_offset 160\n"
+    "    stp x19, x20, [sp, #0]\n"
+    "    stp x21, x22, [sp, #16]\n"
+    "    stp x23, x24, [sp, #32]\n"
+    "    stp x25, x26, [sp, #48]\n"
+    "    stp x27, x28, [sp, #64]\n"
+    "    stp x29, x30, [sp, #80]\n"
+    "    .cfi_rel_offset x29, 80\n"
+    "    .cfi_rel_offset x30, 88\n"
+    "    stp d8, d9, [sp, #96]\n"
+    "    stp d10, d11, [sp, #112]\n"
+    "    stp d12, d13, [sp, #128]\n"
+    "    stp d14, d15, [sp, #144]\n"
+    "    mov x9, sp\n"
+    "    str x9, [x0]\n"
+    "    mov sp, x1\n"
+    "    ldp x19, x20, [sp, #0]\n"
+    "    ldp x21, x22, [sp, #16]\n"
+    "    ldp x23, x24, [sp, #32]\n"
+    "    ldp x25, x26, [sp, #48]\n"
+    "    ldp x27, x28, [sp, #64]\n"
+    "    ldp x29, x30, [sp, #80]\n"
+    "    ldp d8, d9, [sp, #96]\n"
+    "    ldp d10, d11, [sp, #112]\n"
+    "    ldp d12, d13, [sp, #128]\n"
+    "    ldp d14, d15, [sp, #144]\n"
+    "    add sp, sp, #160\n"
+    "    .cfi_adjust_cfa_offset -160\n"
+    "    mov x0, x2\n"
+    "    ret\n"
+    "    .cfi_endproc\n"
+    ".size coroutine_aarch64_switch, . - coroutine_aarch64_switch\n"
+    "\n"
+    ".balign 4\n"
+    ".hidden coroutine_aarch64_start\n"
+    ".type coroutine_aarch64_start, %function\n"
+    "coroutine_aarch64_start:\n"
+    "    .cfi_startproc\n"
+    /* The end of the stack, for anything that unwinds it. */
+    "    .cfi_undefined x30\n"
+    "    mov x0, x19\n"
+    "    bl coroutine_aarch64_main\n"
+    "    brk #1\n"
+    "    .cfi_endproc\n"
+    ".size coroutine_aarch64_start, . - coroutine_aarch64_start\n"
+);
+
+void __attribute__((used, visibility("hidden"), noreturn))
+coroutine_aarch64_main(CoroutineAArch64 *self);
+
+void coroutine_aarch64_main(CoroutineAArch64 *self)
+{
+    Coroutine *co = &self->base;
+
+    while (true) {
+        co->entry(co->entry_arg);
+        qemu_coroutine_switch(co, co->caller, COROUTINE_TERMINATE);
+    }
+}
+
+Coroutine *qemu_coroutine_new(void)
+{
+    CoroutineAArch64 *co = g_malloc0(sizeof(*co));
+    uintptr_t top;
+    uint64_t *frame;
+
+    co->stack_size = COROUTINE_STACK_SIZE;
+    co->stack = qemu_alloc_stack(&co->stack_size);
+
+    top = QEMU_ALIGN_DOWN((uintptr_t)co->stack + co->stack_size, 16);
+    frame = (uint64_t *)(top - FRAME_WORDS * sizeof(uint64_t));
+    memset(frame, 0, FRAME_WORDS * sizeof(uint64_t));
+    frame[FRAME_X19] = (uintptr_t)co;
+    frame[FRAME_X30] = (uintptr_t)coroutine_aarch64_start;
+    co->sp = frame;
+
+    return &co->base;
+}
+
+void qemu_coroutine_delete(Coroutine *co_)
+{
+    CoroutineAArch64 *co = DO_UPCAST(CoroutineAArch64, base, co_);
+
+    qemu_free_stack(co->stack, co->stack_size);
+    g_free(co);
+}
+
+/*
+ * Not inlined, so that the address of the "current" TLS variable is not
+ * hoisted out of coroutine_aarch64_main()'s loop: a coroutine can come back
+ * on another thread.
+ */
+CoroutineAction __attribute__((noinline))
+qemu_coroutine_switch(Coroutine *from_, Coroutine *to_,
+                      CoroutineAction action)
+{
+    CoroutineAArch64 *from = DO_UPCAST(CoroutineAArch64, base, from_);
+    CoroutineAArch64 *to = DO_UPCAST(CoroutineAArch64, base, to_);
+
+    set_current(to_);
+    return coroutine_aarch64_switch(&from->sp, to->sp, action);
+}
+
+Coroutine *qemu_coroutine_self(void)
+{
+    Coroutine *self = get_current();
+    CoroutineAArch64 *leaderp = get_ptr_leader();
+
+    if (!self) {
+        self = &leaderp->base;
+        set_current(self);
+    }
+    return self;
+}
+
+bool qemu_in_coroutine(void)
+{
+    Coroutine *self = get_current();
+
+    return self && self->caller;
+}
