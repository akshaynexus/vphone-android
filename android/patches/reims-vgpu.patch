+
+    /// A layout for a 100×50 point window at scale 2.
+    fn a_layout() -> Layout {
+        geometry::layout((100.0, 50.0), 2.0, Insets::default(), Some((1920, 1080)))
+    }
+
+    /// A target that names no window, for the state's logic.
+    fn a_target() -> Target {
+        Target::empty()
+    }
+
+    impl Surface {
+        /// The next draw, past every release.
+        fn next_draw(&self, retry: Option<Work>) -> Option<Work> {
+            let mut held = self.state.lock().generation;
+            let mut retry = retry;
+            loop {
+                match self.next(retry.take(), held)? {
+                    Step::Release(generation) => held = generation,
+                    Step::Draw(work) => return Some(work),
+                }
+            }
+        }
+    }
+
+    /// Nothing is drawn while the window is hidden, and the window is drawn again as it shows
+    #[test]
+    fn a_hidden_window_is_drawn_when_it_shows() {
+        let mut s = SurfaceState {
+            target: Some(a_target()),
+            layout: Some(a_layout()),
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        assert!(s.take().is_none());
+        s.visible = true;
+        assert!(s.take().is_some());
+        assert!(s.take().is_none(), "one draw per request");
+    }
+
+    /// Nothing is drawn before SDL's window and the layout
+    #[test]
+    fn nothing_is_drawn_before_the_window_and_layout() {
+        let mut s = SurfaceState {
+            visible: true,
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        assert!(s.take().is_none());
+        s.layout = Some(a_layout());
+        assert!(s.take().is_none());
+        s.target = Some(a_target());
+        assert_eq!(s.take().map(|w| w.layout), Some(a_layout()));
+    }
+
+    /// Showing again, a new layout and a new frame each ask for a draw; an unchanged layout does
+    /// not; a draw with no image comes again
+    #[test]
+    fn what_asks_for_a_draw() {
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().is_some());
+        surface.set_layout(a_layout());
+        assert!(surface.state.lock().take().is_none());
+        surface.request_draw();
+        let work = surface.next_draw(None).unwrap();
+        let again = surface.next_draw(Some(work)).unwrap();
+        assert_eq!(
+            again.layout,
+            a_layout(),
+            "the draw with no image comes again"
+        );
+        surface.set_visible(false);
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().is_some());
+        surface.close();
+        assert!(surface.next_draw(None).is_none());
+    }
+
+    /// A new target comes first as a release, whatever is drawn, and then the draws are over it
+    #[test]
+    fn a_new_target_releases_before_it_draws() {
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        let held = surface.state.lock().generation;
+        assert!(matches!(surface.next(None, 0), Some(Step::Release(g)) if g == held));
+        surface.released(held);
+        assert!(matches!(surface.next(None, held), Some(Step::Draw(_))));
+        surface.set_target(a_target());
+        let newer = surface.state.lock().generation;
+        assert!(newer > held);
+        assert!(matches!(surface.next(None, held), Some(Step::Release(g)) if g == newer));
+    }
+
+    /// A changed decoration asks for a draw, with no frame of the guest's, and is handed to it;
+    /// an unchanged one does not, and a plain one is none
+    #[test]
+    fn a_changed_decoration_is_drawn() {
+        use crate::decor::Rotation;
+
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().unwrap().decoration.is_none());
+        surface.set_decoration(Decoration::default());
+        assert!(surface.state.lock().take().is_none(), "plain: as before");
+        let turned = Decoration {
+            rotation: Rotation::Quarter,
+            bar: None,
+        };
+        surface.set_decoration(turned.clone());
+        let work = surface.state.lock().take().unwrap();
+        assert_eq!(work.decoration.as_deref(), Some(&turned));
+        surface.set_decoration(turned);
+        assert!(surface.state.lock().take().is_none());
+        surface.set_decoration(Decoration::default());
+        assert!(surface.state.lock().take().unwrap().decoration.is_none());
+    }
+
+    /// A draw that had no image in time is not made again while the window is hidden: it is
+    /// made once the window shows
+    #[test]
+    fn a_hidden_window_takes_no_retry() {
+        let mut s = SurfaceState {
+            target: Some(a_target()),
+            layout: Some(a_layout()),
+            visible: true,
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        let work = s.take().unwrap();
+        assert!(s.retake(work).is_some(), "shown, the draw comes again");
+        let work = Work {
+            target: a_target(),
+            layout: a_layout(),
+            decoration: None,
+        };
+        s.visible = false;
+        assert!(s.retake(work).is_none(), "hidden, it does not");
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(false);
+        surface.set_visible(true);
+        assert!(
+            surface.state.lock().take().is_some(),
+            "shown again, it is drawn"
+        );
+    }
+}
