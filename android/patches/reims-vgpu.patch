+    }
+
+    /// Nothing is drawn before SDL's window and the layout
+    #[test]
+    fn nothing_is_drawn_before_the_window_and_layout() {
+        let mut s = SurfaceState {
+            visible: true,
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        assert!(s.take().is_none());
+        s.layout = Some(a_layout());
+        assert!(s.take().is_none());
+        s.target = Some(a_target());
+        assert_eq!(s.take().map(|w| w.layout), Some(a_layout()));
+    }
+
+    /// Showing again, a new layout and a new frame each ask for a draw; an unchanged layout does
+    /// not; a draw with no image comes again
+    #[test]
+    fn what_asks_for_a_draw() {
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().is_some());
+        surface.set_layout(a_layout());
+        assert!(surface.state.lock().take().is_none());
+        surface.request_draw();
+        let work = surface.next_draw(None).unwrap();
+        let again = surface.next_draw(Some(work)).unwrap();
+        assert_eq!(
+            again.layout,
+            a_layout(),
+            "the draw with no image comes again"
+        );
+        surface.set_visible(false);
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().is_some());
+        surface.close();
+        assert!(surface.next_draw(None).is_none());
+    }
+
+    /// A new target comes first as a release, whatever is drawn, and then the draws are over it
+    #[test]
+    fn a_new_target_releases_before_it_draws() {
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        let held = surface.state.lock().generation;
+        assert!(matches!(surface.next(None, 0), Some(Step::Release(g)) if g == held));
+        surface.released(held);
+        assert!(matches!(surface.next(None, held), Some(Step::Draw(_))));
+        surface.set_target(a_target());
+        let newer = surface.state.lock().generation;
+        assert!(newer > held);
+        assert!(matches!(surface.next(None, held), Some(Step::Release(g)) if g == newer));
+    }
+
+    /// A changed decoration asks for a draw, with no frame of the guest's, and is handed to it;
+    /// an unchanged one does not, and a plain one is none
+    #[test]
+    fn a_changed_decoration_is_drawn() {
+        use crate::decor::Rotation;
+
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
