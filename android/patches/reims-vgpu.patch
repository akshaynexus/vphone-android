@@ -0,0 +1,116 @@
+//! The copy of the software display (`software`): a frame's rows into a window's locked buffer,
+//! at the buffer's stride. Apart from the presenter so the build machine tests it.
+
+use std::ffi::c_void;
+
+/// `WINDOW_FORMAT_RGBA_8888`.
+pub(super) const FORMAT_RGBA_8888: i32 = 1;
+/// `WINDOW_FORMAT_RGBX_8888`: the same bytes, the fourth unused.
+pub(super) const FORMAT_RGBX_8888: i32 = 2;
+
+/// `ANativeWindow_Buffer`.
+#[repr(C)]
+pub(super) struct Buffer {
+    /// Pixels per row that are shown.
+    pub(super) width: i32,
+    /// Rows.
+    pub(super) height: i32,
+    /// Pixels per row in memory.
+    pub(super) stride: i32,
+    /// A `WINDOW_FORMAT_*`.
+    pub(super) format: i32,
+    /// The pixels.
+    pub(super) bits: *mut c_void,
+    /// Unused.
+    pub(super) reserved: [u32; 6],
+}
+
+/// Copies `pixels`, `width` by `height` tight rows of four bytes a pixel, into the locked
+/// `buffer`, each row at the buffer's stride, as many pixels and rows as both have.
+pub(super) fn copy_rows(buffer: &Buffer, width: i32, height: i32, pixels: &[u8]) -> Result<(), String> {
+    if !(buffer.format == FORMAT_RGBA_8888 || buffer.format == FORMAT_RGBX_8888) {
+        return Err(format!(
+            "the window's buffer has format {}, not RGBA_8888",
+            buffer.format
+        ));
+    }
+    let size = |v: i32| usize::try_from(v).ok().filter(|&v| v > 0);
+    let (Some(src_width), Some(src_height), Some(dst_width), Some(dst_height), Some(stride)) = (
+        size(width),
+        size(height),
+        size(buffer.width),
+        size(buffer.height),
+        size(buffer.stride),
+    ) else {
+        return Err(format!(
+            "a buffer of {}x{} with a stride of {} pixels for a frame of {width}x{height}",
+            buffer.width, buffer.height, buffer.stride
+        ));
+    };
+    if buffer.bits.is_null() || stride < dst_width || pixels.len() < src_width * src_height * 4 {
+        return Err("a buffer or a frame smaller than its size says".to_owned());
+    }
+    let row_bytes = src_width.min(dst_width) * 4;
+    let rows = src_height.min(dst_height);
+    for (y, row) in pixels.chunks_exact(src_width * 4).take(rows).enumerate() {
+        // SAFETY: the locked buffer holds `height` rows of `stride` pixels of four bytes; row
+        // `y` is below `height` and `row_bytes` is at most `width * 4`, which `stride * 4`
+        // covers; the source row holds `row_bytes` and the two do not overlap.
+        unsafe {
+            let dst = buffer.bits.cast::<u8>().add(y * stride * 4);
+            std::ptr::copy_nonoverlapping(row.as_ptr(), dst, row_bytes);
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Rows land at the buffer's stride, and no byte past a row's pixels is written.
+    #[test]
+    fn rows_are_copied_at_the_buffers_stride() {
+        // A 3x2 frame into a 3x2 buffer whose rows are 5 pixels apart.
+        let pixels: Vec<u8> = (1..=24).collect();
+        let mut memory = vec![0u8; 5 * 4 * 2];
+        let buffer = Buffer {
+            width: 3,
+            height: 2,
+            stride: 5,
+            format: FORMAT_RGBA_8888,
+            bits: memory.as_mut_ptr().cast(),
+            reserved: [0; 6],
+        };
+        assert_eq!(copy_rows(&buffer, 3, 2, &pixels), Ok(()));
+        assert_eq!(memory[..12], pixels[..12]);
+        assert!(memory[12..20].iter().all(|&b| b == 0));
+        assert_eq!(memory[20..32], pixels[12..]);
+        assert!(memory[32..].iter().all(|&b| b == 0));
+    }
+
+    /// A buffer smaller than the frame takes the frame's top left, and one of another format
+    /// or with no memory takes nothing.
+    #[test]
+    fn a_buffer_of_another_size_or_format() {
+        let pixels: Vec<u8> = (1..=24).collect();
+        let mut memory = vec![0u8; 2 * 4];
+        let mut buffer = Buffer {
+            width: 2,
+            height: 1,
+            stride: 2,
+            format: FORMAT_RGBX_8888,
+            bits: memory.as_mut_ptr().cast(),
+            reserved: [0; 6],
+        };
+        assert_eq!(copy_rows(&buffer, 3, 2, &pixels), Ok(()));
+        assert_eq!(memory, pixels[..8]);
+        buffer.format = 4; // RGB_565
+        assert!(copy_rows(&buffer, 3, 2, &pixels).is_err());
+        buffer.format = FORMAT_RGBA_8888;
+        buffer.bits = std::ptr::null_mut();
+        assert!(copy_rows(&buffer, 3, 2, &pixels).is_err());
+        buffer.bits = memory.as_mut_ptr().cast();
+        assert!(copy_rows(&buffer, 3, 2, &pixels[..20]).is_err());
+    }
+}
