diff --git a/crates/reims-vgpu-core/src/perf.rs b/crates/reims-vgpu-core/src/perf.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4ff30ba9f44b0a72adf4bb1830a6ffbe658234d1
--- /dev/null
+++ b/crates/reims-vgpu-core/src/perf.rs
@@ -0,0 +1,152 @@
+//! Where the frame path's wall time goes, a diagnostic a host reads as one line
+//! (`reims_vgpu::perf_line`, the Android app's `[vphone] gpu` line). Every figure is a sum since
+//! the last reading: no line is written here, and nothing the guest or the host sees changes.
+//!
+//! - **The FIFO threads** ([`Stage::FifoIdle`], [`Stage::FifoBarrier`], [`Stage::FifoRun`]): each
+//!   command's wait for its bytes (the guest has sent nothing: the host is idle), its wait for its
+//!   barriers (the stamps of earlier work, the GPU's completions among them) and its handler's
+//!   run (the host's own work: decoding, the runtime's calls, the driver's). Summed over every
+//!   FIFO thread, so a period of S seconds with N busy FIFOs can hold up to N x S of each.
+//! - **Each opcode's handler time** ([`opcode`], [`top_opcodes`]): which commands the run time
+//!   is spent in.
+//! - **The window** ([`Stage::Acquire`], [`Stage::WindowEncode`], [`Stage::Present`]): a drawn
+//!   frame's wait for a swapchain image, its encoding and commit, and its present.
+//!
+//! A reading costs two clock reads a stage (the vDSO's, tens of nanoseconds) and two relaxed
+//! atomic adds.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+/// A part of the frame path whose time is summed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Stage {
+    /// A FIFO thread waiting for the guest's next command.
+    FifoIdle,
+    /// A FIFO thread waiting for a command's barriers.
+    FifoBarrier,
+    /// A FIFO thread running a command's handler.
+    FifoRun,
+    /// The window's wait for a swapchain image.
+    Acquire,
+    /// The window's frame encoded and committed.
+    WindowEncode,
+    /// The window's present.
+    Present,
+}
+
+/// How many stages there are.
+const STAGES: usize = 6;
+
+/// Opcodes whose handler time is kept apart; a higher one is summed into the last slot.
+const OPCODES: usize = 512;
+
+/// A sum of times and how many.
+struct Sum {
+    count: AtomicU64,
+    nanos: AtomicU64,
+}
+
+impl Sum {
+    const fn new() -> Sum {
+        Sum {
+            count: AtomicU64::new(0),
+            nanos: AtomicU64::new(0),
+        }
+    }
+
+    fn add(&self, nanos: u64) {
+        self.count.fetch_add(1, Relaxed);
+        self.nanos.fetch_add(nanos, Relaxed);
+    }
+
+    fn take(&self) -> (u64, u64) {
+        (self.count.swap(0, Relaxed), self.nanos.swap(0, Relaxed))
+    }
+}
+
+static SUMS: [Sum; STAGES] = [const { Sum::new() }; STAGES];
+static BY_OPCODE: [Sum; OPCODES] = [const { Sum::new() }; OPCODES];
+
+/// Nanoseconds since the first call, on the monotonic clock.
+#[allow(
+    clippy::disallowed_methods,
+    reason = "a diagnostic's own clock: it must not go through a platform's, which tests replace"
+)]
+pub fn now() -> u64 {
+    static BASE: OnceLock<Instant> = OnceLock::new();
+    let base = *BASE.get_or_init(Instant::now);
+    u64::try_from(Instant::now().saturating_duration_since(base).as_nanos()).unwrap_or(u64::MAX)
+}
+
+/// Adds the time since `began` ([`now`]) to `stage`; the time now, for the next stage.
+pub fn add(stage: Stage, began: u64) -> u64 {
+    let at = now();
+    if let Some(sum) = SUMS.get(stage as usize) {
+        sum.add(at.saturating_sub(began));
+    }
+    at
+}
+
+/// Adds `nanos` to opcode `id`'s handler time.
+pub fn opcode(id: u32, nanos: u64) {
+    let slot = usize::try_from(id).unwrap_or(usize::MAX).min(OPCODES - 1);
+    if let Some(sum) = BY_OPCODE.get(slot) {
+        sum.add(nanos);
+    }
+}
+
+/// `stage`'s count and nanoseconds since the last call, which starts its next period.
+pub fn take(stage: Stage) -> (u64, u64) {
+    SUMS.get(stage as usize).map_or((0, 0), Sum::take)
+}
+
+/// The `top` opcodes by handler time since the last call, as (opcode, count, nanoseconds),
+/// longest first; starts every opcode's next period.
+pub fn top_opcodes(top: usize) -> Vec<(u32, u64, u64)> {
+    let mut all: Vec<(u32, u64, u64)> = BY_OPCODE
+        .iter()
+        .zip(0u32..)
+        .map(|(sum, id)| {
+            let (count, nanos) = sum.take();
+            (id, count, nanos)
+        })
+        .filter(|&(_, count, _)| count > 0)
+        .collect();
+    all.sort_by_key(|&(_, _, nanos)| std::cmp::Reverse(nanos));
+    all.truncate(top);
+    all
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_stage_sums_and_a_reading_starts_it_again() {
+        // Stages are process-wide: this test owns `Present`, which no other core test adds to.
+        let _ = take(Stage::Present);
+        let began = now();
+        let after = add(Stage::Present, began);
+        assert!(after >= began);
+        add(Stage::Present, began);
+        let (count, nanos) = take(Stage::Present);
+        assert_eq!(count, 2);
+        assert!(nanos >= after - began);
+        assert_eq!(take(Stage::Present), (0, 0));
+    }
+
+    #[test]
+    fn opcodes_are_ranked_by_their_time() {
+        // Opcodes no handler has (the table ends far below): this test's own slots.
