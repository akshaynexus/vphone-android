diff --git a/crates/reims-vgpu-vulkan/src/perf_counts.rs b/crates/reims-vgpu-vulkan/src/perf_counts.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0fe01a8284f34b7b4ac28ad187b288b65f032b76
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/perf_counts.rs
@@ -0,0 +1,92 @@
+//! The runtime's work counts a host's frame-path line reads (`reims_vgpu::perf_line`): the few
+//! of `rt::WorkCounts` that say where a frame's host time went, from the first device adopted. A
+//! diagnostic: nothing here is read unless a host asks, and a reading has the runtime settle its
+//! commits as `work_log`'s does, so a host asks rarely (the Android app, every 30 seconds).
+
+use std::sync::OnceLock;
+
+use metal2vulkan_runtime as rt;
+
+/// The first device adopted, whose counts are read.
+static DEVICE: OnceLock<rt::Device> = OnceLock::new();
+
+/// Keeps `device` for [`counts`], where it is the process's first.
+pub(crate) fn adopt(device: &rt::Device) {
+    let _ = DEVICE.get_or_init(|| device.clone());
+}
+
+/// What the runtime did so far, since the device was adopted.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Counts {
+    /// `VkCommandBuffer`s submitted.
+    pub command_buffers: u64,
+    /// `vkQueueSubmit` calls.
+    pub submissions: u64,
+    /// Nanoseconds inside `vkQueueSubmit`.
+    pub submit_nanos: u64,
+    /// Nanoseconds inside `vkCreateGraphicsPipelines` and `vkCreateComputePipelines`.
+    pub pipeline_nanos: u64,
+    /// Shader functions translated (not found in a cache).
+    pub translated: u64,
+    /// Nanoseconds reading the shader cache on disk.
+    pub shader_cache_nanos: u64,
+    /// Nanoseconds the batches' host steps took (records read, commands recorded).
+    pub host_step_nanos: u64,
+    /// Nanoseconds batches spent held before their submission.
+    pub hold_nanos: u64,
+    /// Nanoseconds makes of a command buffer waited for a slot of a full queue.
+    pub slot_wait_nanos: u64,
+    /// Shadow copies of textures over host bytes.
+    pub shadow_copies: u64,
+    /// Mappings asked about before imports of host pages.
+    pub mappings_queried: u64,
+    /// Readings of `/proc/self/maps`' lines for those, where the kernel answers no query.
+    pub maps_reads: u64,
+    /// Nanoseconds those readings took.
+    pub maps_read_nanos: u64,
+}
+
+impl Counts {
+    /// What happened since `earlier`.
+    #[must_use]
+    pub fn since(&self, earlier: &Counts) -> Counts {
+        Counts {
+            command_buffers: self.command_buffers.saturating_sub(earlier.command_buffers),
+            submissions: self.submissions.saturating_sub(earlier.submissions),
+            submit_nanos: self.submit_nanos.saturating_sub(earlier.submit_nanos),
+            pipeline_nanos: self.pipeline_nanos.saturating_sub(earlier.pipeline_nanos),
+            translated: self.translated.saturating_sub(earlier.translated),
+            shader_cache_nanos: (self.shader_cache_nanos)
+                .saturating_sub(earlier.shader_cache_nanos),
+            host_step_nanos: self.host_step_nanos.saturating_sub(earlier.host_step_nanos),
+            hold_nanos: self.hold_nanos.saturating_sub(earlier.hold_nanos),
+            slot_wait_nanos: self.slot_wait_nanos.saturating_sub(earlier.slot_wait_nanos),
+            shadow_copies: self.shadow_copies.saturating_sub(earlier.shadow_copies),
+            mappings_queried: self.mappings_queried.saturating_sub(earlier.mappings_queried),
+            maps_reads: self.maps_reads.saturating_sub(earlier.maps_reads),
+            maps_read_nanos: self.maps_read_nanos.saturating_sub(earlier.maps_read_nanos),
+        }
+    }
+}
+
+/// The counts now; `None` before the first device.
+pub fn counts() -> Option<Counts> {
+    let work = DEVICE.get()?.work_counts();
+    let (maps_reads, maps_read_nanos) = rt::host_maps_line_reads();
+    Some(Counts {
+        command_buffers: work.command_buffers_submitted,
+        submissions: work.queue_submissions,
+        submit_nanos: work.batch_submit_nanos,
+        pipeline_nanos: (work.render_pipeline_create_nanos)
+            .saturating_add(work.compute_pipeline_create_nanos),
+        translated: work.functions_translated,
+        shader_cache_nanos: work.shader_cache_read_nanos,
+        host_step_nanos: work.host_step_nanos,
+        hold_nanos: work.batch_hold_nanos,
+        slot_wait_nanos: work.slot_wait_nanos,
+        shadow_copies: work.shadow_copies,
+        mappings_queried: work.host_mappings_queried,
+        maps_reads,
+        maps_read_nanos,
+    })
+}
