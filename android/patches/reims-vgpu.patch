+    /// Registers the `vkGetInstanceProcAddr` every Vulkan instance of the process goes through
+    /// (`metal2vulkan_runtime::set_android_vulkan_gipa`), before the first device is made.
+    ///
+    /// # Safety
+    ///
+    /// `gipa` is a valid `vkGetInstanceProcAddr` that stays loaded for the life of the process.
+    pub unsafe fn set_vulkan_gipa(gipa: *mut std::ffi::c_void) {
+        // SAFETY: the caller's: a pointer of that type, or NULL.
+        let gipa = unsafe {
+            std::mem::transmute::<
+                *mut std::ffi::c_void,
+                Option<reims_vgpu_vulkan::ash_vk::PFN_vkGetInstanceProcAddr>,
+            >(gipa)
+        };
+        // SAFETY: the caller's.
+        unsafe { reims_vgpu_vulkan::set_android_vulkan_gipa(gipa) };
+    }
+}
diff --git a/crates/reims-vgpu/src/perf.rs b/crates/reims-vgpu/src/perf.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dd71cdf7773c9dd44adf71dee880e36c2a135966
--- /dev/null
+++ b/crates/reims-vgpu/src/perf.rs
@@ -0,0 +1,285 @@
+//! One line saying where a guest frame's time goes, for a host that asks ([`line`]; the Android
+//! app writes it as `[vphone] gpu ...` every 30 seconds). A diagnostic: nothing the guest sees.
+//!
+//! The line holds, over the time since the last one:
+//! - the guest's presents a second against the cap (the display mode's refresh rate), the time
+//!   between two as a multiple of the cap's frame budget, and the longest gap. They need
+//!   `REIMS_VGPU_STATS` (`collect` keeps them without the every-second lines of `crate::stats`);
+//! - per guest frame, in milliseconds and as a share of the budget: the FIFO threads' time
+//!   waiting for the guest (`guest`), waiting for barriers (`barriers`) and running commands
+//!   (`host`), with the opcodes that took most of it; the window's wait for an image, its
+//!   encoding and its present (`reims_vgpu_core::perf`); and the runtime's own figures
+//!   (`reims_vgpu_vulkan::perf_counts`): `vkQueueSubmit`, pipeline makings, host steps, batches
+//!   held, readings of `/proc/self/maps`.
+//!
+//! The FIFO figures are sums over every FIFO thread, so `guest + barriers + host` can exceed
+//! the time between two frames: several FIFOs wait at once. `host` is the bound: a frame cannot
+//! come sooner than the host's own work for it, and a `host` far below the frame time says the
+//! frame waits on the guest's CPU, not on this library.
+
+use std::fmt::Write as _;
+use std::sync::atomic::{AtomicU8, Ordering::Relaxed};
+
+use reims_vgpu_core::fifo::commands::Opcode;
+use reims_vgpu_core::perf::{self, Stage};
+use reims_vgpu_core::sync::Mutex;
+use reims_vgpu_vulkan::perf_counts::{self, Counts};
+
+/// How the window presents: 0 not yet, 1 MAILBOX, 2 FIFO.
+static PRESENTS_WITH: AtomicU8 = AtomicU8::new(0);
+
+/// The runtime's counts at the last line.
+static LAST: Mutex<Option<Counts>> = Mutex::new(None);
+
+/// The window's swapchain was made, with MAILBOX or FIFO.
+pub(crate) fn presents_with(mailbox: bool) {
+    PRESENTS_WITH.store(if mailbox { 1 } else { 2 }, Relaxed);
+}
+
+/// What a line is written from.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Reading {
+    /// The cap: the display mode's refresh rate, in Hz.
+    pub cap_hz: u32,
+    /// Seconds the reading covers.
+    pub seconds: f64,
+    /// The guest's presents, and the longest gap between two in nanoseconds; `None` where the
+    /// statistics are off.
+    pub guest: Option<(u64, Option<u64>)>,
+    /// The window's draws, and of those with a GPU time, how many and their nanoseconds.
+    pub drawn: (u64, u64, u64),
+    /// How the window presents ([`PRESENTS_WITH`]).
+    pub mode: u8,
+    /// Each stage's count and nanoseconds, in [`STAGES`]' order.
+    pub stages: [(u64, u64); 6],
+    /// The opcodes that took most of the handlers' time: (opcode, count, nanoseconds).
+    pub opcodes: Vec<(u32, u64, u64)>,
+    /// The runtime's counts over the reading; `None` before a device.
+    pub counts: Option<Counts>,
+}
+
+/// The stages of a reading, in order.
+const STAGES: [Stage; 6] = [
+    Stage::FifoIdle,
+    Stage::FifoBarrier,
+    Stage::FifoRun,
+    Stage::Acquire,
+    Stage::WindowEncode,
+    Stage::Present,
+];
+
+/// Takes a reading for a display mode of `cap_hz`: every figure's next period starts.
+pub fn read(cap_hz: u32) -> Reading {
+    let taken = crate::stats::taken();
+    let counts = perf_counts::counts();
+    let since = {
+        let mut last = LAST.lock();
+        let since = counts.map(|now| now.since(&last.unwrap_or_default()));
+        *last = counts.or(*last);
+        since
+    };
+    Reading {
+        cap_hz,
+        seconds: taken.map_or(0.0, |t| t.seconds),
+        guest: taken.map(|t| (t.guest, t.guest_gap)),
+        drawn: taken.map_or((0, 0, 0), |t| (t.drawn, t.gpu.0, t.gpu.1)),
+        mode: PRESENTS_WITH.load(Relaxed),
+        stages: STAGES.map(perf::take),
+        opcodes: perf::top_opcodes(3),
+        counts: since,
+    }
+}
+
+/// [`read`], as its line ([`Reading::line`]).
+pub fn line(cap_hz: u32) -> String {
+    read(cap_hz).line()
+}
+
+/// Nanoseconds as milliseconds.
+fn ms(nanos: u64) -> f64 {
+    nanos as f64 / 1e6
+}
+
+impl Reading {
+    /// The line (the module docs). Per-frame figures divide by the guest's presents; with none
+    /// (or the statistics off) they are given a second, and say so.
+    pub fn line(&self) -> String {
+        let cap = self.cap_hz.max(1);
+        let budget = 1000.0 / f64::from(cap);
+        let mut out = String::new();
+        let frames = self.guest.map_or(0, |g| g.0);
+        match self.guest {
+            None => out.push_str("guest frames not counted"),
+            Some((count, gap)) => {
+                let fps = if self.seconds > 0.0 {
+                    count as f64 / self.seconds
+                } else {
+                    0.0
+                };
+                let _ = write!(out, "guest {fps:.1} fps of {cap}");
+                if count > 0 && fps > 0.0 {
+                    let each = 1000.0 / fps;
+                    let _ = write!(
+                        out,
+                        " ({each:.1} ms a frame, {:.1}x the {budget:.1} ms budget",
+                        each / budget
+                    );
+                    if let Some(gap) = gap {
+                        let _ = write!(out, ", longest gap {:.0} ms", ms(gap));
+                    }
+                    out.push(')');
+                }
+            }
+        }
+        let window = if self.seconds > 0.0 {
+            self.drawn.0 as f64 / self.seconds
+        } else {
+            0.0
+        };
+        let mode = match self.mode {
+            1 => " MAILBOX",
+            2 => " FIFO",
+            _ => "",
+        };
+        let _ = write!(out, "; window {window:.1} fps{mode}");
+        // Per guest frame where there is one, else per second.
+        let (per, unit) = if frames > 0 {
+            (frames as f64, "per guest frame")
+        } else {
+            (self.seconds.max(1e-9), "per second (no guest frame)")
+        };
+        let share = |nanos: u64| {
+            let each = ms(nanos) / per;
+            if frames > 0 {
+                format!("{each:.1} ms ({:.0}%)", each / budget * 100.0)
+            } else {
+                format!("{each:.1} ms")
+            }
+        };
+        let [idle, barrier, run, acquire, encode, present] = self.stages;
+        let _ = write!(
+            out,
+            "; {unit}: guest {}, barriers {}, host {} in {:.0} commands",
+            share(idle.1),
+            share(barrier.1),
+            share(run.1),
+            run.0 as f64 / per
+        );
+        if !self.opcodes.is_empty() {
+            let top: Vec<String> = (self.opcodes.iter())
+                .map(|&(id, count, nanos)| {
+                    let name = u16::try_from(id)
+                        .ok()
+                        .and_then(Opcode::from_id)
+                        .map_or_else(|| format!("op{id}"), |op| format!("{op:?}"));
+                    format!("{name} {:.1} ms x{:.1}", ms(nanos) / per, count as f64 / per)
+                })
+                .collect();
+            let _ = write!(out, " [{}]", top.join(", "));
+        }
+        let _ = write!(
+            out,
+            "; window acquire {} + encode {} + present {}",
+            share(acquire.1),
+            share(encode.1),
+            share(present.1)
+        );
+        if let Some(mean) = self.drawn.2.checked_div(self.drawn.1) {
+            let _ = write!(out, ", GPU {:.1} ms a draw", ms(mean));
+        }
+        match &self.counts {
+            None => out.push_str("; no device yet"),
+            Some(c) => {
+                let _ = write!(
+                    out,
+                    "; runtime: {:.1} command buffers, submit {}, pipelines {}, host steps {}, \
+                     held {}, slot waits {}, maps reads {:.1} = {}, shadow copies {:.1}, \
+                     translated {}",
+                    c.command_buffers as f64 / per,
+                    share(c.submit_nanos),
+                    share(c.pipeline_nanos.saturating_add(c.shader_cache_nanos)),
+                    share(c.host_step_nanos),
+                    share(c.hold_nanos),
+                    share(c.slot_wait_nanos),
+                    c.maps_reads as f64 / per,
+                    share(c.maps_read_nanos),
+                    c.shadow_copies as f64 / per,
+                    c.translated
+                );
+            }
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MS: u64 = 1_000_000;
+
+    #[test]
+    fn a_line_gives_each_stage_its_share_of_the_caps_budget() {
+        let reading = Reading {
+            cap_hz: 120,
+            seconds: 30.0,
+            guest: Some((120, Some(800 * MS))),
+            drawn: (120, 120, 240 * MS),
+            mode: 1,
+            stages: [
+                (9_000, 120 * 200 * MS),
+                (600, 120 * 10 * MS),
+                (9_000, 120 * 50 * MS),
+                (120, 120 * MS / 10),
+                (120, 120 * MS / 2),
+                (120, 120 * MS / 5),
+            ],
+            opcodes: vec![(0, 240, 120 * 25 * MS), (400, 120, 120 * MS)],
+            counts: Some(Counts {
+                command_buffers: 1_200,
+                submit_nanos: 120 * 2 * MS,
+                maps_reads: 600,
+                maps_read_nanos: 600 * 12 * MS,
+                ..Counts::default()
+            }),
+        };
+        let line = reading.line();
+        assert!(
+            line.starts_with(
+                "guest 4.0 fps of 120 (250.0 ms a frame, 30.0x the 8.3 ms budget, longest gap \
+                 800 ms); window 4.0 fps MAILBOX; per guest frame: guest 200.0 ms (2400%), \
+                 barriers 10.0 ms (120%), host 50.0 ms (600%) in 75 commands [Debug 25.0 ms \
+                 x2.0, op400 1.0 ms x1.0]; window acquire 0.1 ms (1%) + encode 0.5 ms (6%) + \
+                 present 0.2 ms (2%), GPU 2.0 ms a draw; runtime: 10.0 command buffers, submit \
+                 2.0 ms (24%), "
+            ),
+            "{line}"
+        );
+        assert!(line.contains("maps reads 5.0 = 60.0 ms (720%)"), "{line}");
+    }
+
+    #[test]
+    fn with_no_guest_frame_the_figures_are_a_second() {
+        let reading = Reading {
+            cap_hz: 60,
+            seconds: 10.0,
+            guest: Some((0, None)),
+            stages: [(5, 20_000 * MS), (0, 0), (5, 50 * MS), (0, 0), (0, 0), (0, 0)],
+            ..Reading::default()
+        };
+        let line = reading.line();
+        assert!(
+            line.starts_with(
+                "guest 0.0 fps of 60; window 0.0 fps; per second (no guest frame): guest \
+                 2000.0 ms, barriers 0.0 ms, host 5.0 ms in 0 commands; window acquire"
+            ),
+            "{line}"
+        );
+        assert!(line.ends_with("; no device yet"), "{line}");
+        let off = Reading {
+            guest: None,
+            ..reading
+        };
+        assert!(off.line().starts_with("guest frames not counted; window"));
+    }
+}
