diff --git a/crates/reims-vgpu-window/src/native/vulkan_render.rs b/crates/reims-vgpu-window/src/native/vulkan_render.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fd9b4c31ef28b477bfc75e0c5855bf488fb10325
--- /dev/null
+++ b/crates/reims-vgpu-window/src/native/vulkan_render.rs
@@ -0,0 +1,484 @@
+//! A window's render thread, which draws the display's current frame into the window's swapchain
+//! when there is something new to show, the [`Surface`] it shares with the window and the UI
+//! thread, and what the display's sink gives it ([`FrameSink`]).
+//!
+//! One thread per window (`reims-vgpu.window`), started when the window attaches. It waits until
+//! there is something to draw: a new guest frame, a new layout (the window resized, or moved to a
+//! screen of another scale, or the guest set a mode), the window showing again, or a change of
+//! the guest's cursor where the window draws it ([`Window::drawn_cursor`], which each draw hands
+//! the presenter), or a change of what the window draws around the image at its control's say
+//! (the image's rotation, the button bar and which button is lit: [`Surface::set_decoration`],
+//! which each draw hands the presenter too, so the bar repaints with no frame of the guest's).
+//! It draws only
+//! while the window is shown, once SDL's window and the layout exist, through a presenter the sink
+//! makes over the window ([`FrameSink::presenter`]), which makes the window's Vulkan surface
+//! ([`VulkanTarget`]), as `crate::present` says: made at the first draw, tried again after
+//! [`RETRY`] where no image came in time, made again where one ends.
+//!
+//! Requests that come while it draws fold into one: it draws the latest frame once more. It
+//! copies the sink out of the window's lock before asking it, and holds no lock of the window's
+//! while it draws.
+//!
+//! It ends at the window's end ([`Surface::close`]): it drops its presenter, which destroys the
+//! swapchain and the Vulkan surface, and only then posts to the UI thread that SDL's window may go
+//! ([`crate::sdl::shell::released`]), so the surface always goes before the window under it.
+//! Nothing joins it, and the window's end waits for nothing.
+
+use std::sync::Arc;
+
+#[cfg(target_os = "android")]
+use std::time::{Duration, Instant};
+
+use reims_vgpu_core::rt::spawn_named;
+use reims_vgpu_core::sync::{Condvar, Mutex};
+use reims_vgpu_vulkan::os::OsThreads;
+
+#[cfg(target_os = "android")]
+use super::android::{Target, render_ended};
+#[cfg(target_os = "linux")]
+use super::linux::render::{Target, render_ended};
+use crate::decor::Decoration;
+use crate::geometry::Layout;
+use crate::handle::Window;
+use crate::present::{Presenter, Presenting, RETRY, VulkanTarget};
+
+/// The render thread's stack.
+const STACK: usize = 512 * 1024;
+
+/// What draws a display's current frame into a window: `reims-vgpu`'s, over the display, which it
+/// holds weakly.
+pub trait FrameSink: Send + Sync {
+    /// A presenter over `target`'s window: one that makes the window's surface on the sink's
+    /// Vulkan instance and a swapchain over it. `None` where there is none (the display has
+    /// ended, or this host has no swapchain): the window then stays empty.
+    fn presenter(&self, target: &dyn VulkanTarget) -> Option<Box<dyn Presenter>>;
+
+    /// The guest's cursor position, in its mode's pixels, as the display reads it now: `None`
+    /// once the display has ended, without a guest display, while it is paused, and for a sink
+    /// that cannot tell. Asked on the thread of the display's callbacks
+    /// ([`Window::cursor_moved`](crate::Window::cursor_moved)).
+    fn guest_cursor_position(&self) -> Option<(u16, u16)> {
+        None
+    }
+}
+
+/// What the render thread draws with, shared with the window and the UI thread.
+#[derive(Debug, Default)]
+pub(crate) struct Surface {
+    state: Mutex<SurfaceState>,
+    wake: Condvar,
+}
+
+/// The surface's state.
+#[derive(Debug, Default)]
+struct SurfaceState {
+    /// SDL's window, once it has opened on the UI thread.
+    target: Option<Target>,
+    /// Where the drawable and the image are, once the window has laid out.
+    layout: Option<Layout>,
+    /// What is drawn around the image: none for a plain window ([`Decoration::is_plain`]).
+    decoration: Option<Arc<Decoration>>,
+    /// Whether the window is shown.
+    visible: bool,
+    /// Something new to show: a frame, a layout, the window showing again.
+    dirty: bool,
+    /// The window has ended: the render thread ends.
+    closed: bool,
+    /// How many times the target has changed: a render thread that drew over an earlier one lets
+    /// its presenter go first.
+    generation: u64,
+    /// The newest generation the render thread has let go of everything older than.
+    released: u64,
+}
+
+/// What the render thread does next ([`Surface::next`]).
+enum Step {
+    /// The target changed: its presenter, and with it the window's swapchain and Vulkan surface,
+    /// goes, and then it tells [`Surface::wait_released`] it has.
+    Release(u64),
+    /// A draw.
+    Draw(Work),
+}
+
+/// A draw the render thread takes: the OS's window and the layout.
+struct Work {
+    target: Target,
+    layout: Layout,
+    decoration: Option<Arc<Decoration>>,
+}
+
+impl SurfaceState {
+    /// The draw to make now, if any: something new, the window shown, its window and layout
+    /// there.
+    fn take(&mut self) -> Option<Work> {
+        if !(self.dirty && self.visible) {
+            return None;
+        }
+        let (Some(target), Some(layout)) = (&self.target, self.layout) else {
+            return None;
+        };
+        // A copy of the handle on Linux, a reference on Android.
+        #[allow(clippy::clone_on_copy)]
+        let target = target.clone();
+        self.dirty = false;
+        Some(Work {
+            target,
+            layout,
+            decoration: self.decoration.clone(),
+        })
+    }
+
+    /// The draw to make again after one that had no image in time: the newest, else the same,
+    /// while the window is shown. None while it is hidden: the draw waits for it to show, which
+    /// asks for one ([`Surface::set_visible`]).
+    fn retake(&mut self, work: Work) -> Option<Work> {
+        if !self.visible {
+            return None;
+        }
+        Some(self.take().unwrap_or(work))
+    }
+}
+
+impl Surface {
+    /// An empty surface: no window, no layout, not shown.
+    pub(crate) fn new() -> Surface {
+        Surface::default()
+    }
+
+    /// Changes the state with `f` and wakes the render thread.
+    fn update(&self, f: impl FnOnce(&mut SurfaceState)) {
+        f(&mut self.state.lock());
+        self.wake.notify_all();
+    }
+
+    /// The OS's window, as the window opens, or a new one where the old went (Android's Surface,
+    /// replaced each time the app shows again).
+    pub(crate) fn set_target(&self, target: Target) {
+        self.update(|s| {
+            s.target = Some(target);
+            s.dirty = true;
+            s.generation += 1;
+        });
+    }
+
+    /// The OS's window went away: nothing is drawn until the next [`Surface::set_target`], and
+    /// the render thread lets its presenter go.
+    #[cfg(target_os = "android")]
+    pub(crate) fn clear_target(&self) {
+        self.update(|s| {
+            s.target = None;
+            s.generation += 1;
+        });
+    }
+
+    /// Waits, up to `timeout`, for the render thread to let go of every target but the current
+    /// one: whether it did. Called by what is about to give the old window back to the OS.
+    #[cfg(target_os = "android")]
+    pub(crate) fn wait_released(&self, timeout: Duration) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut state = self.state.lock();
+        while state.released < state.generation && !state.closed {
+            let left = deadline.saturating_duration_since(Instant::now());
+            if left.is_zero() {
+                return false;
+            }
+            self.wake.wait_for(&mut state, left);
+        }
+        true
+    }
+
+    /// The render thread has let go of every target older than `generation`.
+    fn released(&self, generation: u64) {
+        self.update(|s| s.released = generation);
+    }
+
+    /// The window's layout: a changed one is drawn.
+    pub(crate) fn set_layout(&self, layout: Layout) {
+        self.update(|s| {
+            if s.layout != Some(layout) {
+                s.layout = Some(layout);
+                s.dirty = true;
+            }
+        });
+    }
+
+    /// What the window draws around the image (`crate::decor`), laid out with the layout the
+    /// window last set: a changed one is drawn. A plain one is none, so a window whose control
+    /// asks for nothing draws as one with no control.
+    pub(crate) fn set_decoration(&self, decoration: Decoration) {
+        let decoration = (!decoration.is_plain()).then(|| Arc::new(decoration));
+        self.update(|s| {
+            if s.decoration != decoration {
+                s.decoration = decoration;
+                s.dirty = true;
+            }
+        });
+    }
+
+    /// Whether the window is shown: nothing is drawn while it is not, and it is drawn again when
+    /// it shows.
+    pub(crate) fn set_visible(&self, visible: bool) {
+        self.update(|s| {
+            if visible && !s.visible {
+                s.dirty = true;
+            }
+            s.visible = visible;
+        });
+    }
+
+    /// The guest presented a frame: it is drawn.
+    pub(crate) fn request_draw(&self) {
+        self.update(|s| s.dirty = true);
+    }
+
+    /// The window's end: the render thread ends.
+    pub(crate) fn close(&self) {
+        self.update(|s| s.closed = true);
+    }
+
+    /// Waits for what the render thread does next; `None` at the window's end. `held` is the
+    /// generation of the target its presenter was made over: a newer one comes first, as a
+    /// release. `retry` asks for the last draw again after [`RETRY`], where nothing newer comes
+    /// first.
+    fn next(&self, retry: Option<Work>, held: u64) -> Option<Step> {
+        let mut state = self.state.lock();
+        if let Some(work) = retry
+            && !state.closed
+        {
+            self.wake.wait_for(&mut state, RETRY);
+            if state.closed {
+                return None;
+            }
+            if state.generation != held {
+                return Some(Step::Release(state.generation));
+            }
+            if let Some(work) = state.retake(work) {
+                return Some(Step::Draw(work));
+            }
+        }
+        loop {
+            if state.closed {
+                return None;
+            }
+            if state.generation != held {
+                return Some(Step::Release(state.generation));
+            }
+            if let Some(work) = state.take() {
+                return Some(Step::Draw(work));
+            }
+            self.wake.wait(&mut state);
+        }
+    }
+}
+
+/// Starts `window`'s render thread.
+pub(crate) fn start(window: Arc<Window>) {
+    spawn_named(
+        &OsThreads::without_hints(),
+        "reims-vgpu.window",
+        STACK,
+        Box::new(()),
+        move || run(&window),
+    );
+}
+
+/// The render thread's body: draws until the window's end, then lets its presenter go and posts
+/// the window's release to the UI thread.
+fn run(window: &Window) {
+    let surface = window.surface();
+    let mut presenting = Presenting::default();
+    let mut retry = None;
+    let mut held = 0;
+    while let Some(step) = surface.next(retry.take(), held) {
+        let work = match step {
+            Step::Release(generation) => {
+                // The old window's swapchain and surface go here, before anything may make a new
+                // one over a window the OS gives this process only one connection to.
+                presenting = Presenting::default();
+                held = generation;
+                surface.released(generation);
+                continue;
+            }
+            Step::Draw(work) => work,
+        };
+        if presenting.needs_presenter() {
+            // The sink is copied out of the window's lock: none is held while it answers.
+            let Some(sink) = window.sink() else {
+                continue;
+            };
+            presenting.make(|| sink.presenter(&work.target));
+        }
+        let cursor = window.drawn_cursor();
+        if presenting.draw_decorated(
+            work.layout.drawable,
+            work.layout.pixels,
+            cursor.as_ref(),
+            work.decoration.as_deref(),
+        ) {
+            retry = Some(work);
+        }
+    }
+    drop(presenting);
+    surface.released(u64::MAX);
+    render_ended(window.id());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geometry::{self, Insets};
+
+    /// A layout for a 100×50 point window at scale 2.
+    fn a_layout() -> Layout {
+        geometry::layout((100.0, 50.0), 2.0, Insets::default(), Some((1920, 1080)))
+    }
+
+    /// A target that names no window, for the state's logic.
+    fn a_target() -> Target {
+        Target::empty()
+    }
+
+    impl Surface {
+        /// The next draw, past every release.
+        fn next_draw(&self, retry: Option<Work>) -> Option<Work> {
+            let mut held = self.state.lock().generation;
+            let mut retry = retry;
+            loop {
+                match self.next(retry.take(), held)? {
+                    Step::Release(generation) => held = generation,
+                    Step::Draw(work) => return Some(work),
+                }
+            }
+        }
+    }
+
+    /// Nothing is drawn while the window is hidden, and the window is drawn again as it shows
+    #[test]
+    fn a_hidden_window_is_drawn_when_it_shows() {
+        let mut s = SurfaceState {
+            target: Some(a_target()),
+            layout: Some(a_layout()),
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        assert!(s.take().is_none());
+        s.visible = true;
+        assert!(s.take().is_some());
+        assert!(s.take().is_none(), "one draw per request");
+    }
+
+    /// Nothing is drawn before SDL's window and the layout
+    #[test]
+    fn nothing_is_drawn_before_the_window_and_layout() {
+        let mut s = SurfaceState {
+            visible: true,
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        assert!(s.take().is_none());
+        s.layout = Some(a_layout());
+        assert!(s.take().is_none());
+        s.target = Some(a_target());
+        assert_eq!(s.take().map(|w| w.layout), Some(a_layout()));
+    }
+
+    /// Showing again, a new layout and a new frame each ask for a draw; an unchanged layout does
+    /// not; a draw with no image comes again
+    #[test]
+    fn what_asks_for_a_draw() {
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().is_some());
+        surface.set_layout(a_layout());
+        assert!(surface.state.lock().take().is_none());
+        surface.request_draw();
+        let work = surface.next_draw(None).unwrap();
+        let again = surface.next_draw(Some(work)).unwrap();
+        assert_eq!(
+            again.layout,
+            a_layout(),
+            "the draw with no image comes again"
+        );
+        surface.set_visible(false);
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().is_some());
+        surface.close();
+        assert!(surface.next_draw(None).is_none());
+    }
+
+    /// A new target comes first as a release, whatever is drawn, and then the draws are over it
+    #[test]
+    fn a_new_target_releases_before_it_draws() {
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        let held = surface.state.lock().generation;
+        assert!(matches!(surface.next(None, 0), Some(Step::Release(g)) if g == held));
+        surface.released(held);
+        assert!(matches!(surface.next(None, held), Some(Step::Draw(_))));
+        surface.set_target(a_target());
+        let newer = surface.state.lock().generation;
+        assert!(newer > held);
+        assert!(matches!(surface.next(None, held), Some(Step::Release(g)) if g == newer));
+    }
+
+    /// A changed decoration asks for a draw, with no frame of the guest's, and is handed to it;
+    /// an unchanged one does not, and a plain one is none
+    #[test]
+    fn a_changed_decoration_is_drawn() {
+        use crate::decor::Rotation;
+
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(true);
+        assert!(surface.state.lock().take().unwrap().decoration.is_none());
+        surface.set_decoration(Decoration::default());
+        assert!(surface.state.lock().take().is_none(), "plain: as before");
+        let turned = Decoration {
+            rotation: Rotation::Quarter,
+            bar: None,
+        };
+        surface.set_decoration(turned.clone());
+        let work = surface.state.lock().take().unwrap();
+        assert_eq!(work.decoration.as_deref(), Some(&turned));
+        surface.set_decoration(turned);
+        assert!(surface.state.lock().take().is_none());
+        surface.set_decoration(Decoration::default());
+        assert!(surface.state.lock().take().unwrap().decoration.is_none());
+    }
+
+    /// A draw that had no image in time is not made again while the window is hidden: it is
+    /// made once the window shows
+    #[test]
+    fn a_hidden_window_takes_no_retry() {
+        let mut s = SurfaceState {
+            target: Some(a_target()),
+            layout: Some(a_layout()),
+            visible: true,
+            dirty: true,
+            ..SurfaceState::default()
+        };
+        let work = s.take().unwrap();
+        assert!(s.retake(work).is_some(), "shown, the draw comes again");
+        let work = Work {
+            target: a_target(),
+            layout: a_layout(),
+            decoration: None,
+        };
+        s.visible = false;
+        assert!(s.retake(work).is_none(), "hidden, it does not");
+        let surface = Surface::new();
+        surface.set_target(a_target());
+        surface.set_layout(a_layout());
+        surface.set_visible(false);
+        surface.set_visible(true);
+        assert!(
+            surface.state.lock().take().is_some(),
+            "shown again, it is drawn"
+        );
+    }
+}
