+//! Frame dumps, a diagnostic for a window whose picture is wrong: with `REIMS_VGPU_FRAME_DUMP`
+//! naming a directory, the window's presenter writes there, every [`PERIOD`] at most, the bytes
+//! of the surface behind the frame it just drew, as the CPU reads them in the guest's pages, and
+//! says so on stderr.
+//!
+//! The bytes are read with plain loads from the host's view of the surface
+//! (`reims_vgpu_vulkan::os::lend_surface_bytes_for_reading`): no Vulkan command, image or copy is
+//! between them and the file. So a dump that shows the picture the guest drew, beside a window
+//! that does not, puts the fault after the surface (the copy into the frame's image, the draw
+//! into the swapchain, the swapchain's image as the compositor reads it); a dump that shows the
+//! window's wrong picture puts it before (what the GPU wrote back into the surface).
+//!
+//! **The file.** `frame-N.rgba` (N cycles through [`KEPT`] files): [`MAGIC`], then the width and
+//! the height as little-endian `u32`s, then one `R G B A` byte quadruple per pixel, rows from the
+//! top with no padding. A surface of 8 bytes per element is read as four half floats per pixel
+//! in `R G B A` order, each clamped to [0, 1] and scaled to a byte with no transfer function;
+//! one of 4 bytes per element as `B G R A` bytes. Alpha is written as 255: the dump is of the
+//! picture, and a viewer that blends it would hide it. Any other surface is not dumped, and the
+//! line on stderr says what it is.
+
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+use reims_vgpu_core::platform::os::surface::Surface as _;
+use reims_vgpu_core::platform::resource::Texture as _;
+use reims_vgpu_vulkan::VulkanPlatform;
+use reims_vgpu_vulkan::os::lend_surface_bytes_for_reading;
+
+use crate::window::SinkDisplay;
+
+/// The switch: the directory the dumps go to.
+const DUMP_VAR: &str = "REIMS_VGPU_FRAME_DUMP";
+
+/// The least time between two dumps.
+const PERIOD: Duration = Duration::from_secs(15);
+
+/// How many files are kept: the dump after the last overwrites the first.
+const KEPT: u32 = 4;
+
+/// What a dump file starts with.
+pub(crate) const MAGIC: &[u8; 8] = b"RVGDUMP1";
+
+/// The directory the environment names, read once per process; `None` without the switch.
+fn directory() -> Option<&'static Path> {
+    static DIR: OnceLock<Option<PathBuf>> = OnceLock::new();
+    DIR.get_or_init(|| {
+        std::env::var_os(DUMP_VAR)
+            .filter(|dir| !dir.is_empty())
+            .map(PathBuf::from)
+    })
+    .as_deref()
+}
+
+/// A presenter's dumps: when the last one was written, and how many were.
+#[derive(Default)]
+pub(crate) struct FrameDumps {
+    last: Option<Instant>,
+    written: u32,
+}
+
+impl FrameDumps {
+    /// After a frame was presented: dumps the surface behind `display`'s current frame where the
+    /// switch is on and [`PERIOD`] has passed since the last dump. Never fails the frame: what
+    /// keeps a dump from being written is said on stderr, once per period.
+    pub(crate) fn presented(&mut self, display: &SinkDisplay<VulkanPlatform>) {
+        let Some(dir) = directory() else {
+            return;
+        };
+        let now = Instant::now();
+        if self.last.is_some_and(|last| now.duration_since(last) < PERIOD) {
+            return;
+        }
+        let Some(frame) = display.current_frame() else {
+            // Before the guest's first frame: asked again at the next one.
+            return;
+        };
+        self.last = Some(now);
+        let said = format!(
+            "a frame of Metal pixel format {}, {}x{}, usage {:#x}",
+            frame.pixel_format(),
+            frame.width(),
+            frame.height(),
+            frame.usage()
+        );
+        let Some(surface) = frame.iosurface() else {
+            eprintln!(
+                "reims-vgpu: frame dump: {said}, over no surface: nothing the CPU reads holds \
+                 it, and it is not dumped"
+            );
+            return;
+        };
+        let shape = Shape {
+            width: surface.width(),
+            height: surface.height(),
+            bytes_per_element: surface.bytes_per_element(),
+            bytes_per_row: surface.bytes_per_row(),
+        };
+        let fourcc = fourcc(surface.pixel_format());
+        let mut pixels = None;
+        let lent = lend_surface_bytes_for_reading(&surface, &mut |bytes| {
+            pixels = rgba(bytes, shape);
+        });
+        let path = dir.join(format!("frame-{}.rgba", self.written % KEPT));
+        let written = match (lent, pixels) {
+            (Err(why), _) => Err(why.to_owned()),
+            (Ok(()), None) => Err(format!(
+                "a surface of {} bytes per element and rows of {} bytes is not one the dump reads",
+                shape.bytes_per_element, shape.bytes_per_row
+            )),
+            (Ok(()), Some(pixels)) => write(&path, shape, &pixels).map_err(|e| e.to_string()),
+        };
+        match written {
+            Ok(()) => {
+                self.written = self.written.wrapping_add(1);
+                eprintln!(
+                    "reims-vgpu: frame dump {}: {said}, over a surface '{fourcc}' of {}x{}, {} \
+                     bytes per element, rows of {} bytes: its bytes in the guest's pages, as the \
+                     CPU reads them, are in {}",
+                    self.written,
+                    shape.width,
+                    shape.height,
+                    shape.bytes_per_element,
+                    shape.bytes_per_row,
+                    path.display()
+                );
+            }
+            Err(why) => eprintln!(
+                "reims-vgpu: frame dump: {said}, over a surface '{fourcc}' of {}x{}: not dumped \
+                 ({why})",
+                shape.width, shape.height
+            ),
+        }
+    }
+}
+
+/// A surface's layout, as the dump reads it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Shape {
+    pub(crate) width: u64,
+    pub(crate) height: u64,
+    pub(crate) bytes_per_element: u64,
+    pub(crate) bytes_per_row: u64,
+}
+
+/// An OSType as its four characters, a `.` for each that does not print.
+fn fourcc(format: u32) -> String {
+    format
+        .to_be_bytes()
+        .iter()
+        .map(|&b| {
+            if b.is_ascii_graphic() {
+                char::from(b)
+            } else {
+                '.'
+            }
+        })
+        .collect()
+}
+
+/// A half float's value.
+fn half(bits: u16) -> f32 {
+    let sign = if bits & 0x8000 == 0 { 1.0 } else { -1.0 };
+    let exponent = i32::from((bits >> 10) & 0x1f);
+    let fraction = f32::from(bits & 0x3ff);
+    let magnitude = match exponent {
+        0 => fraction * 2f32.powi(-24),
+        31 if fraction == 0.0 => f32::INFINITY,
+        31 => f32::NAN,
+        _ => (1.0 + fraction / 1024.0) * 2f32.powi(exponent - 15),
+    };
+    sign * magnitude
+}
+
+/// A color channel's byte: the value clamped to [0, 1] and scaled, a NaN as 0.
+fn byte(value: f32) -> u8 {
+    if value.is_nan() {
+        return 0;
+    }
+    let scaled = (value.clamp(0.0, 1.0) * 255.0).round();
+    // In [0, 255] after the clamp.
+    #[expect(
+        clippy::cast_possible_truncation,
+        clippy::cast_sign_loss,
+        clippy::as_conversions,
+        reason = "the value lies in [0, 255]"
+    )]
+    let byte = scaled as u8;
+    byte
+}
+
+/// The surface's pixels as `R G B A` bytes, rows from the top with no padding (the module doc);
+/// `None` for a layout the dump does not read, or bytes too few for it.
+pub(crate) fn rgba(bytes: &[u8], shape: Shape) -> Option<Vec<u8>> {
+    let width = usize::try_from(shape.width).ok()?;
+    let height = usize::try_from(shape.height).ok()?;
+    let element = usize::try_from(shape.bytes_per_element).ok()?;
+    let pitch = usize::try_from(shape.bytes_per_row).ok()?;
+    if !(element == 4 || element == 8) || width == 0 || height == 0 {
+        return None;
+    }
+    let row_bytes = width.checked_mul(element)?;
+    if pitch < row_bytes {
+        return None;
+    }
+    let needed = pitch.checked_mul(height - 1)?.checked_add(row_bytes)?;
+    if bytes.len() < needed {
+        return None;
+    }
+    let mut out = Vec::with_capacity(width.checked_mul(height)?.checked_mul(4)?);
+    for row in bytes.chunks(pitch).take(height) {
+        for pixel in row.get(..row_bytes)?.chunks_exact(element) {
+            match *pixel {
+                [b, g, r, _] => out.extend_from_slice(&[r, g, b, 255]),
+                [r0, r1, g0, g1, b0, b1, _, _] => out.extend_from_slice(&[
+                    byte(half(u16::from_le_bytes([r0, r1]))),
+                    byte(half(u16::from_le_bytes([g0, g1]))),
+                    byte(half(u16::from_le_bytes([b0, b1]))),
+                    255,
+                ]),
+                _ => return None,
+            }
+        }
+    }
+    Some(out)
+}
+
+/// Writes the dump file (the module doc) beside its final name, then moves it there, so a reader
+/// never sees half a file.
+fn write(path: &Path, shape: Shape, pixels: &[u8]) -> std::io::Result<()> {
+    let (Ok(width), Ok(height)) = (u32::try_from(shape.width), u32::try_from(shape.height)) else {
+        return Err(std::io::Error::other("a surface too large for the header"));
+    };
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let partial = path.with_extension("partial");
+    let mut file = std::fs::File::create(&partial)?;
+    file.write_all(MAGIC)?;
+    file.write_all(&width.to_le_bytes())?;
+    file.write_all(&height.to_le_bytes())?;
+    file.write_all(pixels)?;
+    drop(file);
+    std::fs::rename(&partial, path)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Half floats read as their values
+    #[test]
+    fn halves_read_as_their_values() {
+        assert_eq!(half(0x0000), 0.0);
+        assert_eq!(half(0x3c00), 1.0);
+        assert_eq!(half(0x3800), 0.5);
+        assert_eq!(half(0xbc00), -1.0);
+        assert_eq!(half(0x4000), 2.0);
+        assert_eq!(half(0x0001), 2f32.powi(-24));
+        assert!(half(0x7c00).is_infinite() && half(0x7e00).is_nan());
+        assert_eq!(
+            [byte(0.0), byte(0.5), byte(1.0), byte(7.0), byte(-1.0), byte(f32::NAN)],
+            [0, 128, 255, 255, 0, 0]
+        );
+    }
+
+    /// A surface of half floats is read row by row at its pitch, the bytes between rows left out
+    #[test]
+    fn a_half_float_surface_is_read_at_its_pitch() {
+        let shape = Shape {
+            width: 2,
+            height: 2,
+            bytes_per_element: 8,
+            bytes_per_row: 24,
+        };
+        let one = 0x3c00u16.to_le_bytes();
+        let half_ = 0x3800u16.to_le_bytes();
+        let pixel = |r: [u8; 2], g: [u8; 2], b: [u8; 2]| [r, g, b, one].concat();
+        let mut bytes = Vec::new();
+        bytes.extend(pixel(one, [0, 0], [0, 0]));
+        bytes.extend(pixel([0, 0], one, [0, 0]));
+        bytes.extend([0xee; 8]);
+        bytes.extend(pixel([0, 0], [0, 0], one));
+        bytes.extend(pixel(half_, half_, half_));
+        assert_eq!(
+            rgba(&bytes, shape).unwrap(),
+            [
+                [255, 0, 0, 255],
+                [0, 255, 0, 255],
+                [0, 0, 255, 255],
+                [128, 128, 128, 255]
+            ]
+            .concat()
+        );
+        assert!(rgba(&bytes[..bytes.len() - 1], shape).is_none(), "too few bytes");
+    }
+
+    /// A surface of four bytes per pixel is read as BGRA, and other layouts are not read
+    #[test]
+    fn a_bgra_surface_is_read_and_others_are_not() {
+        let shape = Shape {
+            width: 1,
+            height: 2,
+            bytes_per_element: 4,
+            bytes_per_row: 4,
+        };
+        assert_eq!(
+            rgba(&[1, 2, 3, 4, 5, 6, 7, 8], shape).unwrap(),
+            [3, 2, 1, 255, 7, 6, 5, 255]
+        );
+        let odd = Shape {
+            bytes_per_element: 2,
+            ..shape
+        };
+        assert!(rgba(&[0; 8], odd).is_none());
+        let narrow = Shape {
+            bytes_per_row: 3,
+            ..shape
+        };
+        assert!(rgba(&[0; 8], narrow).is_none());
+        assert_eq!(fourcc(u32::from_be_bytes(*b"RGhA")), "RGhA");
+        assert_eq!(fourcc(1), "....");
+    }
+
+    /// The file is the header and the pixels
+    #[test]
+    fn the_file_is_the_header_and_the_pixels() {
+        let dir = std::env::temp_dir().join(format!("rvg-dump-{}", std::process::id()));
+        let path = dir.join("frame-0.rgba");
+        let shape = Shape {
+            width: 1,
+            height: 1,
+            bytes_per_element: 4,
+            bytes_per_row: 4,
+        };
+        write(&path, shape, &[9, 8, 7, 255]).unwrap();
+        let file = std::fs::read(&path).unwrap();
+        assert_eq!(&file[..8], MAGIC);
+        assert_eq!(&file[8..], [1, 0, 0, 0, 1, 0, 0, 0, 9, 8, 7, 255]);
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+}
diff --git a/crates/reims-vgpu/src/window/vulkan/software.rs b/crates/reims-vgpu/src/window/vulkan/software.rs
new file mode 100644
index 0000000000000000000000000000000000000000..03322572169e94184737ae5522b97e4783203efc
--- /dev/null
+++ b/crates/reims-vgpu/src/window/vulkan/software.rs
@@ -0,0 +1,211 @@
+//! The software display, Android's reference path for a window whose picture is wrong: with
+//! `REIMS_VGPU_SOFTWARE_DISPLAY=1` the window's presenter makes no Vulkan surface and no
+//! swapchain. For each frame it reads the bytes of the surface behind the display's current
+//! frame, as the CPU reads them in the guest's pages (what a frame dump reads, `dump`), and
+//! copies them into the window's next buffer, which it takes with `ANativeWindow_lock` and
+//! posts with `ANativeWindow_unlockAndPost`, row by row at the stride the buffer says.
+//!
+//! No GPU driver and no image layout is between the guest's surface and the buffer the
+//! compositor reads, so the picture is the guest's whatever the driver does with a swapchain.
+//! It costs a conversion and a copy of the whole frame on the CPU per frame, and it draws the
+//! guest's surface only: no cursor and no decoration, which an Android window has none of.
+//!
+//! The buffers are asked for at the surface's size, as RGBA_8888, and the system scales them
+//! to the app's Surface.
+
+use std::ffi::c_void;
+use std::ptr::NonNull;
+use std::sync::Arc;
+
+use reims_vgpu_core::platform::os::surface::Surface as _;
+use reims_vgpu_core::platform::resource::Texture as _;
+use reims_vgpu_vulkan::VulkanPlatform;
+use reims_vgpu_vulkan::os::lend_surface_bytes_for_reading;
+use reims_vgpu_window::{Drawn, DrawnCursor, PixelRect, Presenter, VulkanTarget};
+
+use super::dump::{Shape, rgba};
+use super::software_rows::{Buffer, FORMAT_RGBA_8888, copy_rows};
+use crate::entry;
+use crate::window::SinkDisplay;
+
+/// The switch.
+const SOFTWARE_VAR: &str = "REIMS_VGPU_SOFTWARE_DISPLAY";
+
+unsafe extern "C" {
+    fn ANativeWindow_acquire(window: *mut c_void);
+    fn ANativeWindow_release(window: *mut c_void);
+    fn ANativeWindow_setBuffersGeometry(
+        window: *mut c_void,
+        width: i32,
+        height: i32,
+        format: i32,
+    ) -> i32;
+    fn ANativeWindow_lock(window: *mut c_void, buffer: *mut Buffer, dirty: *mut c_void) -> i32;
+    fn ANativeWindow_unlockAndPost(window: *mut c_void) -> i32;
+}
+
+/// A reference of the presenter's own to the app's window.
+struct Window(NonNull<c_void>);
+
+// SAFETY: an `ANativeWindow`'s reference count and its buffer queue are safe on any thread, and
+// only the presenter's thread locks and posts through this reference.
+unsafe impl Send for Window {}
+
+impl Drop for Window {
+    fn drop(&mut self) {
+        // SAFETY: the reference `presenter` took.
+        unsafe { ANativeWindow_release(self.0.as_ptr()) };
+    }
+}
+
+/// The software presenter over `target`'s window, where the switch is on and the target has
+/// one; `None` otherwise, and the window presents through a swapchain.
+pub(super) fn presenter(
+    display: &Arc<SinkDisplay<VulkanPlatform>>,
+    target: &dyn VulkanTarget,
+) -> Option<Box<dyn Presenter>> {
+    if std::env::var_os(SOFTWARE_VAR).is_none_or(|v| v != "1") {
+        return None;
+    }
+    let window = target.native_window()?;
+    // SAFETY: the target's window is live while the target is, which this call is within.
+    unsafe { ANativeWindow_acquire(window.as_ptr()) };
+    eprintln!(
+        "reims-vgpu: software display: the window is drawn by the CPU from the guest's surface, \
+         through ANativeWindow_lock; no swapchain is made"
+    );
+    Some(Box::new(SoftwarePresenter {
+        display: Arc::clone(display),
+        window: Window(window),
+        geometry: None,
+        said: None,
+    }))
+}
+
+/// A window's presenter that copies the guest's surface into the window's buffers.
+struct SoftwarePresenter {
+    /// The display.
+    display: Arc<SinkDisplay<VulkanPlatform>>,
+    /// The app's window.
+    window: Window,
+    /// The size the window's buffers were last asked for at.
+    geometry: Option<(i32, i32)>,
+    /// What last kept a frame from being posted, said once on stderr until it changes.
+    said: Option<String>,
+}
+
+impl SoftwarePresenter {
+    /// The current frame's pixels as tight `R G B A` rows, and their width and height.
+    fn pixels(&self) -> Result<Option<(i32, i32, Vec<u8>)>, String> {
+        let Some(frame) = self.display.current_frame() else {
+            // Before the guest's first frame.
+            return Ok(None);
+        };
+        let Some(surface) = frame.iosurface() else {
+            return Err("the frame is over no surface the CPU reads".to_owned());
+        };
+        let shape = Shape {
+            width: surface.width(),
+            height: surface.height(),
+            bytes_per_element: surface.bytes_per_element(),
+            bytes_per_row: surface.bytes_per_row(),
+        };
+        let mut pixels = None;
+        lend_surface_bytes_for_reading(&surface, &mut |bytes| {
+            pixels = rgba(bytes, shape);
+        })
+        .map_err(str::to_owned)?;
+        let pixels = pixels.ok_or_else(|| {
+            format!(
+                "a surface of {} bytes per element and rows of {} bytes is not one it reads",
+                shape.bytes_per_element, shape.bytes_per_row
+            )
+        })?;
+        match (i32::try_from(shape.width), i32::try_from(shape.height)) {
+            (Ok(width), Ok(height)) => Ok(Some((width, height, pixels))),
+            _ => Err("a surface too large for a window's buffer".to_owned()),
+        }
+    }
+
+    /// Copies `pixels`, `width` by `height` tight `R G B A` rows, into the window's next buffer
+    /// and posts it.
+    fn post(&mut self, width: i32, height: i32, pixels: &[u8]) -> Result<(), String> {
+        let window = self.window.0.as_ptr();
+        if self.geometry != Some((width, height)) {
+            // SAFETY: a live window, of which the presenter holds a reference.
+            let set = unsafe {
+                ANativeWindow_setBuffersGeometry(window, width, height, FORMAT_RGBA_8888)
+            };
+            if set != 0 {
+                return Err(format!("ANativeWindow_setBuffersGeometry: {set}"));
+            }
+            self.geometry = Some((width, height));
+        }
+        let mut buffer = Buffer {
+            width: 0,
+            height: 0,
+            stride: 0,
+            format: 0,
+            bits: std::ptr::null_mut(),
+            reserved: [0; 6],
+        };
+        // SAFETY: a live window, and a buffer description for it to fill; no dirty rectangle.
+        let locked = unsafe { ANativeWindow_lock(window, &raw mut buffer, std::ptr::null_mut()) };
+        if locked != 0 {
+            return Err(format!(
+                "ANativeWindow_lock: {locked} (a window a swapchain was made over stays the \
+                 swapchain's until its Surface is made again)"
+            ));
+        }
+        let copied = copy_rows(&buffer, width, height, pixels);
+        // SAFETY: the buffer locked above; nothing reads `bits` after this.
+        let posted = unsafe { ANativeWindow_unlockAndPost(window) };
+        copied?;
+        if posted != 0 {
+            return Err(format!("ANativeWindow_unlockAndPost: {posted}"));
+        }
+        Ok(())
+    }
+
+    /// Says `why` on stderr where it is not what was last said.
+    fn say(&mut self, why: Option<String>) {
+        if self.said != why {
+            match &why {
+                Some(why) => eprintln!("reims-vgpu: software display: no frame posted: {why}"),
+                None => eprintln!("reims-vgpu: software display: frames are posted"),
+            }
+            self.said = why;
+        }
+    }
+}
+
+impl Presenter for SoftwarePresenter {
+    /// The display's current frame, copied into the window's next buffer and posted (the
+    /// module doc). The drawable, the region and the cursor are not used: the buffer is the
+    /// guest's surface, which the system scales to the window.
+    fn draw(
+        &mut self,
+        _drawable: (u64, u64),
+        _region: PixelRect,
+        _cursor: Option<&DrawnCursor>,
+    ) -> Drawn {
+        let pixels = entry::run(|_| self.pixels());
+        match pixels {
+            Ok(None) => Drawn::Nothing,
+            Ok(Some((width, height, pixels))) => match self.post(width, height, &pixels) {
+                Ok(()) => {
+                    self.say(None);
+                    Drawn::Presented
+                }
+                Err(why) => {
+                    self.say(Some(why));
+                    Drawn::Nothing
+                }
+            },
+            Err(why) => {
+                self.say(Some(why));
+                Drawn::Nothing
+            }
+        }
+    }
+}
