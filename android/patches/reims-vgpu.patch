diff --git a/crates/reims-vgpu-window/src/native/android.rs b/crates/reims-vgpu-window/src/native/android.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cecb9d5f11b7185409857349d4fe90f07659f024
--- /dev/null
+++ b/crates/reims-vgpu-window/src/native/android.rs
@@ -0,0 +1,369 @@
+//! The window on Android: the app's `ANativeWindow`, drawn through Vulkan by the render thread
+//! Linux's window uses (`crate::native::vulkan_render`). There is no window system to open here:
+//! the app owns the only Surface and hands it over with [`set_window`], from its
+//! `surfaceCreated` / `surfaceChanged` / `surfaceDestroyed`, before or after the display exists.
+//! It draws the display of the first window open, the guest's primary display; a later window
+//! waits and takes over when that one ends.
+//!
+//! **A Surface that comes and goes.** Android destroys the Surface whenever the app is not shown,
+//! and makes a new one when it is shown again. The library holds its own reference to the window
+//! it was given. [`set_window`] with another window (or NULL) has the render thread let its
+//! swapchain and Vulkan surface go, and waits a bounded time for that before it returns, as
+//! `surfaceDestroyed` must not return with a producer still connected to the old window
+//! ([`RELEASE_WAIT`]); the guest runs on regardless, and the next window draws whatever frame is
+//! current. The same window again (a `surfaceChanged`) lays out again for its new size.
+//!
+//! **The image.** The whole Surface is the drawable, one pixel per window pixel, and the image
+//! is the guest's mode fitted inside it, centred ([`crate::geometry::layout`]).
+//!
+//! **Touch.** The app sends touches in the guest's pixels with [`pointer`], which go to the host
+//! through the window's pointer callback on the library's thread `reims-vgpu.ui`, one at a time
+//! in the order they came, as Linux's window sends its events, never inside the call of the app's
+//! that made them.
+
+use std::ffi::{CStr, c_void};
+use std::ptr::NonNull;
+use std::sync::mpsc::{self, Sender};
+use std::sync::{Arc, OnceLock};
+use std::time::Duration;
+
+use ash::vk;
+use reims_vgpu_core::platform::os::{Clock as _, MonoTime};
+use reims_vgpu_core::rt::spawn_named;
+use reims_vgpu_core::sync::Mutex;
+use reims_vgpu_vulkan::os::{OsClock, OsThreads};
+
+use super::vulkan_render as render_thread;
+pub use render_thread::FrameSink;
+pub(crate) use render_thread::Surface;
+
+use crate::geometry::{self, Insets};
+use crate::handle::Window;
+use crate::policy::DEFAULT_REFRESH_HZ;
+use crate::present::VulkanTarget;
+use crate::screens::HostScreen;
+
+/// How long [`set_window`] waits for the render thread to let the old window go. The render
+/// thread can be inside a draw, which waits at most about 33 ms for an image, and a queue idle at
+/// a swapchain's end; past this the app goes on and the window is let go when the thread is done.
+const RELEASE_WAIT: Duration = Duration::from_secs(2);
+
+/// The input thread's stack.
+const INPUT_STACK: usize = 256 * 1024;
+
+#[link(name = "android")]
+unsafe extern "C" {
+    fn ANativeWindow_acquire(window: *mut c_void);
+    fn ANativeWindow_release(window: *mut c_void);
+    fn ANativeWindow_getWidth(window: *mut c_void) -> i32;
+    fn ANativeWindow_getHeight(window: *mut c_void) -> i32;
+}
+
+/// A reference of the library's own to an `ANativeWindow`.
+#[derive(Debug)]
+struct NativeWindow(NonNull<c_void>);
+
+// SAFETY: `ANativeWindow`'s reference count and the queries made here are safe on any thread.
+unsafe impl Send for NativeWindow {}
+// SAFETY: as above.
+unsafe impl Sync for NativeWindow {}
+
+impl NativeWindow {
+    /// A new reference to `window`.
+    ///
+    /// # Safety
+    ///
+    /// `window` is a live `ANativeWindow`.
+    unsafe fn acquire(window: NonNull<c_void>) -> Arc<NativeWindow> {
+        // SAFETY: the caller's.
+        unsafe { ANativeWindow_acquire(window.as_ptr()) };
+        Arc::new(NativeWindow(window))
+    }
+
+    /// Its size in pixels; `None` where it has no pixels yet.
+    fn pixels(&self) -> Option<(u32, u32)> {
+        // SAFETY: the window is live while this reference is.
+        let (width, height) = unsafe {
+            (
+                ANativeWindow_getWidth(self.0.as_ptr()),
+                ANativeWindow_getHeight(self.0.as_ptr()),
+            )
+        };
+        let width = u32::try_from(width).ok().filter(|w| *w > 0)?;
+        let height = u32::try_from(height).ok().filter(|h| *h > 0)?;
+        Some((width, height))
+    }
+}
+
+impl Drop for NativeWindow {
+    fn drop(&mut self) {
+        // SAFETY: the reference [`NativeWindow::acquire`] took.
+        unsafe { ANativeWindow_release(self.0.as_ptr()) };
+    }
+}
+
+/// The app's window, as the render thread holds it.
+#[derive(Clone, Debug)]
+pub(crate) struct Target(Option<Arc<NativeWindow>>);
+
+impl Target {
+    /// A target over `window`.
+    fn of(window: &Arc<NativeWindow>) -> Target {
+        Target(Some(Arc::clone(window)))
+    }
+
+    /// A target that names no window.
+    #[cfg(test)]
+    pub(in crate::native) fn empty() -> Target {
+        Target(None)
+    }
+}
+
+impl VulkanTarget for Target {
+    /// `vkCreateAndroidSurfaceKHR` of the window, looked up on `instance` through the loader the
+    /// runtime opened, the hooked one the app registered.
+    fn create_surface(
+        &self,
+        get_instance_proc_addr: vk::PFN_vkGetInstanceProcAddr,
+        instance: vk::Instance,
+    ) -> Option<vk::SurfaceKHR> {
+        let window = self.0.as_ref()?;
+        const NAME: &CStr = c"vkCreateAndroidSurfaceKHR";
+        // SAFETY: the instance is live; the name is NUL-terminated.
+        let found = unsafe { get_instance_proc_addr(instance, NAME.as_ptr()) };
+        let Some(found) = found else {
+            log::warn!(
+                target: "reims_vgpu_window",
+                "the instance has no vkCreateAndroidSurfaceKHR: the window stays empty"
+            );
+            return None;
+        };
+        // SAFETY: the loader answered this command for this name, with this signature.
+        let create: vk::PFN_vkCreateAndroidSurfaceKHR = unsafe { std::mem::transmute(found) };
+        let info = vk::AndroidSurfaceCreateInfoKHR::default().window(window.0.as_ptr().cast());
+        let mut surface = vk::SurfaceKHR::null();
+        // SAFETY: a valid create info over a live window, on a live instance.
+        let result = unsafe { create(instance, &info, std::ptr::null(), &mut surface) };
+        if result == vk::Result::SUCCESS {
+            Some(surface)
+        } else {
+            log::warn!(
+                target: "reims_vgpu_window",
+                "vkCreateAndroidSurfaceKHR: {result}: the window stays empty for now"
+            );
+            None
+        }
+    }
+
+    /// The app's `ANativeWindow`.
+    fn native_window(&self) -> Option<NonNull<c_void>> {
+        self.0.as_ref().map(|window| window.0)
+    }
+}
+
+/// The app's window and the windows open, the first of which it shows.
+struct Shared {
+    native: Option<Arc<NativeWindow>>,
+    windows: Vec<Arc<Window>>,
+}
+
+static SHARED: Mutex<Shared> = Mutex::new(Shared {
+    native: None,
+    windows: Vec::new(),
+});
+
+/// Lays out `window` over `native`'s pixels, for the mode the guest set.
+fn lay_out(window: &Window, native: &NativeWindow) {
+    let Some((width, height)) = native.pixels() else {
+        return;
+    };
+    let layout = geometry::layout(
+        (f64::from(width), f64::from(height)),
+        1.0,
+        Insets::default(),
+        window.mode(),
+    );
+    window.surface().set_layout(layout);
+}
+
+/// Gives `window` the app's window to draw into, where it has it.
+fn show(window: &Window, native: Option<&Arc<NativeWindow>>) {
+    if let Some(native) = native {
+        window.surface().set_target(Target::of(native));
+        lay_out(window, native);
+    }
+}
+
+/// The app's Surface (`ANativeWindow*`; NULL when it goes away). See the module doc.
+///
+/// # Safety
+///
+/// `window` is NULL or a live `ANativeWindow`.
+pub unsafe fn set_window(window: *mut c_void) {
+    let new = NonNull::new(window).map(|window| {
+        // SAFETY: the caller's.
+        unsafe { NativeWindow::acquire(window) }
+    });
+    let mut shared = SHARED.lock();
+    let same = match (&shared.native, &new) {
+        (Some(old), Some(new)) => old.0 == new.0,
+        (None, None) => true,
+        _ => false,
+    };
+    let primary = shared.windows.first().map(Arc::clone);
+    if same {
+        // The window's size may have changed (`surfaceChanged`).
+        if let (Some(window), Some(native)) = (primary, new) {
+            drop(shared);
+            lay_out(&window, &native);
+        }
+        return;
+    }
+    shared.native = new.as_ref().map(Arc::clone);
+    drop(shared);
+    log::info!(
+        target: "reims_vgpu_window",
+        "the app's window {}",
+        if new.is_some() { "changed" } else { "went away" }
+    );
+    let Some(window) = primary else {
+        return;
+    };
+    match &new {
+        Some(native) => show(&window, Some(native)),
+        None => window.surface().clear_target(),
+    }
+    if !window.surface().wait_released(RELEASE_WAIT) {
+        log::warn!(
+            target: "reims_vgpu_window",
+            "the render thread still holds the app's old window after {RELEASE_WAIT:?}"
+        );
+    }
+}
+
+/// A touch or a mouse event, in the guest's pixels, with the `RVG_WINDOW_BUTTON_*` bits held. It
+/// goes to the host from the input thread (the module doc); before a window opens or the guest
+/// has set a mode there is nothing to send it to, and it is dropped.
+pub fn pointer(x: u16, y: u16, buttons: u32) {
+    let sent = input_thread().lock().send((x, y, buttons));
+    debug_assert!(
+        sent.is_ok(),
+        "the input thread outlives the process's windows"
+    );
+}
+
+/// The sender to the input thread, started the first time it is asked for.
+fn input_thread() -> &'static Mutex<Sender<(u16, u16, u32)>> {
+    static SENDER: OnceLock<Mutex<Sender<(u16, u16, u32)>>> = OnceLock::new();
+    SENDER.get_or_init(|| {
+        let (sender, events) = mpsc::channel::<(u16, u16, u32)>();
+        spawn_named(
+            &OsThreads::without_hints(),
+            "reims-vgpu.ui",
+            INPUT_STACK,
+            Box::new(()),
+            move || {
+                for (x, y, buttons) in events {
+                    send_pointer(x, y, buttons);
+                }
+            },
+        );
+        Mutex::new(sender)
+    })
+}
+
+/// Sends the host a pointer event over the shown window, held inside the guest's mode as every
+/// window's pointer is.
+fn send_pointer(x: u16, y: u16, buttons: u32) {
+    let Some(window) = SHARED.lock().windows.first().map(Arc::clone) else {
+        return;
+    };
+    let Some((width, height)) = window.mode().filter(|&(w, h)| w > 0 && h > 0) else {
+        return;
+    };
+    window.pointer_sent();
+    let Some(callbacks) = window.callbacks() else {
+        return;
+    };
+    if let Some(pointer) = &callbacks.pointer {
+        pointer(x.min(width - 1), y.min(height - 1), width, height, buttons);
+    }
+}
+
+/// Starts `window`'s render thread and shows it where it is the first window open.
+pub(crate) fn open(window: &Arc<Window>) {
+    render_thread::start(Arc::clone(window));
+    window.opening();
+    window.surface().set_visible(true);
+    let mut shared = SHARED.lock();
+    shared.windows.push(Arc::clone(window));
+    if shared.windows.len() == 1 {
+        let native = shared.native.as_ref().map(Arc::clone);
+        drop(shared);
+        show(window, native.as_ref());
+    }
+}
+
+/// The window `id` of the open windows, and the app's window.
+fn window_of(id: u64) -> (Option<Arc<Window>>, Option<Arc<NativeWindow>>) {
+    let shared = SHARED.lock();
+    (
+        shared.windows.iter().find(|w| w.id() == id).map(Arc::clone),
+        shared.native.as_ref().map(Arc::clone),
+    )
+}
+
+/// The guest of window `id` set a mode: the image is laid out again.
+pub(crate) fn guest_mode_changed(id: u64) {
+    if let (Some(window), Some(native)) = window_of(id) {
+        lay_out(&window, &native);
+    }
+}
+
+/// The guest of window `id` changed its cursor or showed or hid it: drawn with the next frame.
+pub(crate) fn cursor_changed(id: u64) {
+    if let (Some(window), _) = window_of(id) {
+        window.take_cursor_refresh();
+        window.surface().request_draw();
+    }
+}
+
+/// Window `id` ended: it is forgotten, and the next window open, if any, is shown.
+pub(crate) fn close(id: u64) {
+    let (next, native) = {
+        let mut shared = SHARED.lock();
+        let was_primary = shared.windows.first().is_some_and(|w| w.id() == id);
+        shared.windows.retain(|w| w.id() != id);
+        let next = was_primary
+            .then(|| shared.windows.first().map(Arc::clone))
+            .flatten();
+        (next, shared.native.as_ref().map(Arc::clone))
+    };
+    if let Some(next) = next {
+        show(&next, native.as_ref());
+    }
+}
+
+/// Nothing is kept of a window whose render thread has ended.
+pub(in crate::native) fn render_ended(_id: u64) {}
+
+/// Now, on the monotonic clock the library's platform reads.
+pub(crate) fn now() -> MonoTime {
+    OsClock::new().now_mono()
+}
+
+/// The host's screens: the app's window, where it has pixels. Android gives a Surface no refresh
+/// rate through the NDK, so a display matching it offers the default.
+pub(crate) fn host_screens() -> Vec<HostScreen> {
+    let native = SHARED.lock().native.as_ref().map(Arc::clone);
+    native
+        .and_then(|native| native.pixels())
+        .map(|pixels| HostScreen {
+            id: 0,
+            pixels,
+            scale: 1.0,
+            refresh_hz: DEFAULT_REFRESH_HZ,
+        })
+        .into_iter()
+        .collect()
+}
