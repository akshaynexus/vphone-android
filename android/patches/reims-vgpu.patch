diff --git a/crates/reims-vgpu-c/include/reims_vgpu_android.h b/crates/reims-vgpu-c/include/reims_vgpu_android.h
new file mode 100644
index 0000000000000000000000000000000000000000..c91f847de8e473b7185f4fae13bb1e7323c27f52
--- /dev/null
+++ b/crates/reims-vgpu-c/include/reims_vgpu_android.h
@@ -0,0 +1,40 @@
+/*
+ * reims_vgpu_android.h: the Android-only part of reims-vgpu's C API (crates/reims-vgpu-c/src/android.rs).
+ *
+ * The dist tree's reims_vgpu.h includes this file under __ANDROID__, so a host includes that one.
+ */
+#ifndef REIMS_VGPU_ANDROID_H
+#define REIMS_VGPU_ANDROID_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Registers the vkGetInstanceProcAddr every Vulkan instance of the process goes through: the
+// app's hooked driver (libadrenotools). Call before qemu_android_main. It stays loaded for the
+// life of the process.
+void rvg_android_set_vulkan_gipa(void *pfn_vk_get_instance_proc_addr);
+
+// Gives the library the app's Surface, an ANativeWindow*, or NULL when it goes away. The library
+// takes its own reference. Call from surfaceCreated, surfaceChanged and surfaceDestroyed; it
+// waits, for at most two seconds, for the render thread to let an old window go.
+void rvg_android_set_window(void *a_native_window);
+
+// A touch or a mouse event at (x, y) in the guest's display pixels, with the
+// RVG_WINDOW_BUTTON_* bits of the buttons held; it reaches the host through the window's pointer
+// callback, on the library's own thread.
+void rvg_android_pointer(uint16_t x, uint16_t y, uint32_t buttons);
+
+// Writes one line saying where the guest's frame time went since the last call, for a display
+// mode of cap_hz, into buffer: at most capacity bytes, with no terminator. Returns the bytes
+// written. A diagnostic: call it rarely (every 30 seconds).
+size_t rvg_android_perf_line(uint32_t cap_hz, uint8_t *buffer, size_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* REIMS_VGPU_ANDROID_H */
diff --git a/crates/reims-vgpu-c/src/android.rs b/crates/reims-vgpu-c/src/android.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f309b7a77d4ab69234ea54843292e94867c2fd5a
--- /dev/null
+++ b/crates/reims-vgpu-c/src/android.rs
@@ -0,0 +1,73 @@
+//! The Android-only C API, `include/reims_vgpu_android.h`: what the app gives the library that a
+//! desktop host's window system gives it itself. Each call runs on the caller's thread.
+
+use std::ffi::c_void;
+
+use crate::ffi;
+
+/// Registers the `vkGetInstanceProcAddr` every Vulkan instance of the process goes through.
+///
+/// # Safety
+///
+/// `pfn_vk_get_instance_proc_addr` is NULL or a valid `vkGetInstanceProcAddr` that stays loaded
+/// for the life of the process, and this runs before `qemu_android_main`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_android_set_vulkan_gipa(pfn_vk_get_instance_proc_addr: *mut c_void) {
+    ffi::export(|| {
+        // SAFETY: the caller's.
+        unsafe { reims_vgpu::android::set_vulkan_gipa(pfn_vk_get_instance_proc_addr) }
+    })
+}
+
+/// Gives the library the app's Surface: an `ANativeWindow*`, or NULL when it goes away.
+///
+/// # Safety
+///
+/// `a_native_window` is NULL or a live `ANativeWindow`; the library takes its own reference.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_android_set_window(a_native_window: *mut c_void) {
+    ffi::export(|| {
+        // SAFETY: the caller's.
+        unsafe { reims_vgpu::android::set_window(a_native_window) }
+    })
+}
+
+/// A touch or a mouse event, at (`x`, `y`) in the guest's display pixels, with the
+/// `RVG_WINDOW_BUTTON_*` bits of the buttons held.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_android_pointer(x: u16, y: u16, buttons: u32) {
+    ffi::export(|| {
+        reims_vgpu::android::pointer(x, y, buttons);
+    })
+}
+
+/// Writes the frame path's line (`reims_vgpu::perf`) for a display mode of `cap_hz` into
+/// `buffer`, at most `capacity` bytes with no terminator, and returns the bytes written: where
+/// the guest's frame time goes, since the last call. A diagnostic; a host calls it rarely (each
+/// call has the runtime settle its commits to count them).
+///
+/// # Safety
+///
+/// `buffer` is NULL or `capacity` writable bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_android_perf_line(
+    cap_hz: u32,
+    buffer: *mut u8,
+    capacity: usize,
+) -> usize {
+    if buffer.is_null() {
+        return 0;
+    }
+    let mut written = 0;
+    ffi::export(|| {
+        let line = reims_vgpu::perf::line(cap_hz);
+        let mut length = line.len().min(capacity);
+        while !line.is_char_boundary(length) {
+            length -= 1;
+        }
+        // SAFETY: the caller's buffer holds `capacity` bytes, and `length` is no more.
+        unsafe { std::ptr::copy_nonoverlapping(line.as_ptr(), buffer, length) };
+        written = length;
+    });
+    written
+}
