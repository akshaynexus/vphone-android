+
+/// The answers a kernel without `PROCMAP_QUERY` gives through the lines of the maps
+/// (`lines_permitted`), as an Android app's process gets them: a window mapped with the
+/// permission is answered from the kept reading, with no reading, until a change is said over it
+/// (`host_mappings_changed`); a window the kept reading does not show so is read from the file,
+/// so a mapping made without a word is found, and a no is never kept; the eighth such check
+/// reads the file whole and keeps it anew; a change said while a reading is under way counts
+/// against that reading; a view mapped piece after piece is one change; and more changes than
+/// are kept drop the reading.
+#[cfg(target_os = "linux")]
+#[test]
+fn a_kept_reading_of_the_maps_answers_until_a_change_is_said() {
+    use crate::host_mappings_changed;
+    use crate::host_memory::{lines_permitted, read_mappings, MappingLine};
+    use std::cell::Cell;
+    let page = host_page().unwrap();
+    let len = 3 * page as usize;
+    let map = || {
+        // SAFETY: a fresh private mapping, unmapped below.
+        let at = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        assert_ne!(at, libc::MAP_FAILED);
+        at
+    };
+    // Readings of the file: up to a window, and whole.
+    let (partial, whole) = (Cell::new(0u32), Cell::new(0u32));
+    let read = |up_to: Option<u64>| {
+        let count = if up_to.is_some() { &partial } else { &whole };
+        count.set(count.get() + 1);
+        read_mappings(up_to)
+    };
+    // The answer, and the readings it took: up to the window, whole.
+    let ask = |start: u64, end: u64, access: Access| {
+        let before = (partial.get(), whole.get());
+        let answer = lines_permitted(start, end, access, &mut 0, &read);
+        (answer, partial.get() - before.0, whole.get() - before.1)
+    };
+    // Nothing kept yet: start from a dropped reading whatever ran before.
+    for i in 0..5000u64 {
+        host_mappings_changed(i << 20, 0x1000);
+    }
+    let at = map();
+    let (start, end) = (at as u64, at as u64 + len as u64);
+    assert_eq!(ask(start, end, Access::Write), (Some(true), 0, 1), "nothing kept: read whole");
+    assert_eq!(ask(start, end, Access::Write), (Some(true), 0, 0), "kept");
+    assert_eq!(ask(start + page, end, Access::Read), (Some(true), 0, 0), "kept, another access");
+    // A page made read-only, and said: the window is asked of the file; what the change left
+    // is kept. (Misses 1 and 2.)
+    // SAFETY: a page of the mapping above.
+    let protected =
+        unsafe { libc::mprotect(at.byte_add(page as usize), page as usize, libc::PROT_READ) };
+    assert_eq!(protected, 0);
+    host_mappings_changed(start + page, page);
+    assert_eq!(ask(start, end, Access::Write), (Some(false), 1, 0));
+    assert_eq!(ask(start, start + page, Access::Write), (Some(true), 0, 0), "the first page, kept");
+    assert_eq!(ask(start, end, Access::Read), (Some(true), 1, 0), "over the change: asked");
+    // A mapping made without a word is found by the reading its missing answer causes, each
+    // time until a whole reading holds it. (Misses 3 and 4.)
+    let other = map();
+    let (other_start, other_end) = (other as u64, other as u64 + len as u64);
+    assert_eq!(ask(other_start, other_end, Access::Write), (Some(true), 1, 0));
+    assert_eq!(ask(other_start, other_end, Access::Write), (Some(true), 1, 0));
+    // Unmapped, and said: not mapped. (Miss 5.)
+    // SAFETY: the mapping above, which nothing uses.
+    assert_eq!(unsafe { libc::munmap(other, len) }, 0);
+    host_mappings_changed(other_start, len as u64);
+    assert_eq!(ask(other_start, other_end, Access::Read), (Some(false), 1, 0));
+    assert_eq!(ask(start, start + page, Access::Write), (Some(true), 0, 0), "elsewhere, kept");
+    // Misses 6 and 7 are asked up to the window; the eighth reads the file whole and keeps it,
+    // and the change it saw no longer counts against it.
+    assert_eq!(ask(start, end, Access::Read), (Some(true), 1, 0));
+    assert_eq!(ask(start, end, Access::Read), (Some(true), 1, 0));
+    assert_eq!(ask(start, end, Access::Read), (Some(true), 0, 1));
+    assert_eq!(ask(start, end, Access::Read), (Some(true), 0, 0), "kept anew");
+    // A no is never kept: each asks the file.
+    assert_eq!(ask(start, end, Access::Write), (Some(false), 1, 0));
+    assert_eq!(ask(start, end, Access::Write), (Some(false), 1, 0));
+    // A view mapped a piece after another is one change, however many pieces: the reading
+    // stays, and answers for what the pieces do not touch.
+    for i in 0..5000u64 {
+        host_mappings_changed(end + (1 << 30) + i * page, page);
+    }
+    assert_eq!(ask(start, start + page, Access::Write), (Some(true), 0, 0), "one change");
+    // More changes apart than are kept: the reading is dropped whole.
+    for i in 0..5000u64 {
+        host_mappings_changed(i << 20, 0x1000);
+    }
+    // A change said while a reading is under way is after that reading began: the reading is
+    // kept, but not for the changed range.
+    let during = |up_to: Option<u64>| -> Option<Vec<MappingLine>> {
+        assert_eq!(up_to, None, "nothing kept: read whole");
+        let mappings = read_mappings(None);
+        host_mappings_changed(start, page);
+        mappings
+    };
+    assert_eq!(
+        lines_permitted(start, start + page, Access::Write, &mut 0, &during),
+        Some(true)
+    );
+    assert_eq!(ask(start, start + page, Access::Write), (Some(true), 1, 0), "said meanwhile");
+    assert_eq!(ask(start + 2 * page, end, Access::Write), (Some(true), 0, 0), "the rest, kept");
+    // No reading to give: no answer.
+    assert_eq!(
+        lines_permitted(start, start + page, Access::Write, &mut 0, &|_| None),
+        None
+    );
+    // SAFETY: the mapping above, which nothing uses.
+    assert_eq!(unsafe { libc::munmap(at, len) }, 0);
+    host_mappings_changed(start, len as u64);
+    assert_eq!(ask(start, end, Access::Read), (Some(false), 1, 0), "unmapped and said");
+}
