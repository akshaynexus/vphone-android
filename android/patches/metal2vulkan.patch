+#[cfg(test)]
+mod tests {
+    use super::{AdrenoGeneration, DeviceDescription, QUALCOMM_VENDOR_ID};
+    use crate::device::ApiVersion;
+    use crate::vk::DriverId;
+
+    fn turnip(device_id: u32) -> DeviceDescription {
+        let mut description = DeviceDescription::new(ApiVersion::V1_2);
+        description.driver_id = Some(DriverId::MESA_TURNIP);
+        description.vendor_id = QUALCOMM_VENDOR_ID;
+        description.device_id = device_id;
+        description
+    }
+
+    #[test]
+    fn turnip_names_the_adreno_gpus_mesa_lists() {
+        let a750 = turnip(0x43051401).adreno().expect("the Adreno 750");
+        assert_eq!(
+            (a750.name, a750.generation),
+            ("Adreno 750", AdrenoGeneration::A7xx)
+        );
+        for id in [0x44050A31, 0x44050A21] {
+            let a840 = turnip(id).adreno().expect("the Adreno 840");
+            assert_eq!(
+                (a840.name, a840.generation),
+                ("Adreno 840", AdrenoGeneration::A8xx)
+            );
+        }
+        assert_eq!(turnip(0x43050A01).adreno(), None);
+    }
+
+    #[test]
+    fn only_turnip_on_qualcomm_is_named() {
+        let mut other_driver = turnip(0x43051401);
+        other_driver.driver_id = Some(DriverId::QUALCOMM_PROPRIETARY);
+        assert_eq!(other_driver.adreno(), None);
+        let mut other_vendor = turnip(0x43051401);
+        other_vendor.vendor_id = 0x10de;
+        assert_eq!(other_vendor.adreno(), None);
+    }
+}
