diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index ca3fca595d5..3336dc1d81c 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -8674,6 +8674,16 @@ tu6_draw_common(struct tu_cmd_buffer *cmd,
    if (cmd->state.dirty & TU_CMD_DIRTY_FS)
       tu_flush_dynamic_input_attachments<CHIP>(cmd);
 
+   /* SINGLE_PRIM_MODE orders overlapping primitives; rasterization order
+    * also runs across draws, so wait for the previous draw's critical
+    * sections and drop what the caches hold before an interlocked draw.
+    */
+   if (cmd->state.shaders[MESA_SHADER_FRAGMENT] &&
+       cmd->state.shaders[MESA_SHADER_FRAGMENT]->fs.uses_interlock) {
+      cmd->state.renderpass_cache.flush_bits |=
+         TU_CMD_FLAG_WAIT_FOR_IDLE | TU_CMD_FLAG_CACHE_INVALIDATE;
+   }
+
    tu_emit_cache_flush_renderpass<CHIP>(cmd);
 
   if (BITSET_TEST(cmd->vk.dynamic_graphics_state.dirty,
