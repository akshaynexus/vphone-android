diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 1005f49a444..becdc06652d 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -7,6 +7,7 @@
 #include <fcntl.h>
 #include <linux/dma-heap.h>
 #include <poll.h>
+#include <inttypes.h>
 #include <stdint.h>
 #include <sys/ioctl.h>
 #include <sys/mman.h>
@@ -679,6 +680,110 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+/* Import application memory by its address, VK_EXT_external_memory_host.
+ *
+ * KGSL takes the pages with get_user_pages(), FOLL_WRITE unless the object is
+ * GPU read-only, so any mapping GUP can resolve imports: anonymous memory
+ * and shared file mappings, a memfd among them (graphics-kernel
+ * kgsl.c:memdesc_sg_virt()). Its own constraints are that the address and the
+ * length are multiples of the kernel's page size, what
+ * minImportedHostPointerAlignment says, and that the range is writable and
+ * mapped with one cache mode. The kernel holds a reference to each page
+ * until the object is freed and maps those pages, so the GPU keeps the
+ * physical pages it was given whatever is later mapped at the address.
+ *
+ * The object is only ever advertised as HOST_CACHED | HOST_COHERENT, so it
+ * must be IO-coherent. KGSL drops IOCOHERENT without a cached mode, so the
+ * flags are not optional and the result is checked below.
+ */
+static VkResult
+kgsl_bo_init_userptr(struct tu_device *dev,
+                     struct vk_object_base *base,
+                     struct tu_bo **out_bo,
+                     uint64_t size,
+                     void *host_ptr,
+                     const char *name)
+{
+   const int fd = dev->physical_device->local_fd;
+
+   struct kgsl_gpuobj_import_useraddr useraddr = {
+      .virtaddr = reinterpret_cast<uintptr_t>(host_ptr),
+   };
+   struct kgsl_gpuobj_import req = {
+      .priv = reinterpret_cast<uintptr_t>(&useraddr),
+      .priv_len = size,
+      .flags = KGSL_MEMFLAGS_IOCOHERENT |
+               (KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT),
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+
+   if (safe_ioctl(fd, IOCTL_KGSL_GPUOBJ_IMPORT, &req)) {
+      const int err = errno;
+      /* -ENOMEM: no GPU address, or no pagetables for the range. Anything
+       * else is about the pointer: -EFAULT from GUP (a hole, a page that
+       * cannot be written) or -EINVAL (misaligned, or GUP fell short).
+       */
+      if (err == ENOMEM)
+         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "GPUOBJ_IMPORT of host memory failed (%s)",
+                          strerror(err));
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "GPUOBJ_IMPORT of host pointer %p, 0x%" PRIx64
+                       " bytes failed (%s)", host_ptr, size, strerror(err));
+   }
+
+   struct kgsl_gpuobj_info info_req = {
+      .id = req.id,
+   };
+
+   VkResult result = VK_SUCCESS;
+   if (safe_ioctl(fd, IOCTL_KGSL_GPUOBJ_INFO, &info_req)) {
+      result = vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                         "GPUOBJ_INFO of imported host memory failed (%s)",
+                         strerror(errno));
+   } else if (!(req.flags & KGSL_MEMFLAGS_IOCOHERENT) || !info_req.gpuaddr ||
+              info_req.size != size) {
+      /* The flags come back from the kernel; this kernel did not map the
+       * pages coherently, so the type we advertised would be a lie.
+       */
+      result = vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                         "kgsl imported host memory incoherently (flags 0x%"
+                         PRIx64 ", address 0x%" PRIx64 ", size 0x%" PRIx64 ")",
+                         (uint64_t) req.flags, (uint64_t) info_req.gpuaddr,
+                         (uint64_t) info_req.size);
+   }
+
+   if (result != VK_SUCCESS) {
+      struct kgsl_gpumem_free_id free_req = {
+         .id = req.id,
+      };
+      safe_ioctl(fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+      return result;
+   }
+
+   struct tu_bo *bo = tu_device_lookup_bo(dev, req.id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = req.id,
+      .size = info_req.size,
+      .iova = info_req.gpuaddr,
+      .map = host_ptr,
+      .name = tu_debug_bos_add(dev, info_req.size, name),
+      .refcnt = 1,
+      .shared_fd = -1,
+      .base = base,
+   };
+   bo->never_unmap = true;
+   bo->host_owned_map = true;
+
+   tu_dump_bo_init(dev, bo);
+
+   *out_bo = bo;
+
+   return VK_SUCCESS;
+}
+
 static int
 kgsl_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
 {
@@ -726,7 +831,7 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
    tu_debug_bos_del(dev, bo);
    tu_dump_bo_del(dev, bo);
 
-   if (bo->map) {
+   if (bo->map && !bo->host_owned_map) {
       TU_RMV(bo_unmap, dev, bo);
       munmap(bo->map, bo->size);
    }
@@ -2135,6 +2240,7 @@ static const struct tu_knl kgsl_knl_funcs = {
       .submitqueue_close = kgsl_submitqueue_close,
       .bo_init = kgsl_bo_init,
       .bo_init_dmabuf = kgsl_bo_init_dmabuf,
+      .bo_init_userptr = kgsl_bo_init_userptr,
       .bo_export_dmabuf = kgsl_bo_export_dmabuf,
       .bo_map = kgsl_bo_map,
       .bo_allow_dump = kgsl_bo_allow_dump,
