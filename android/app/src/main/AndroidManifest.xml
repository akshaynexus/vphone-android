<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <!-- Receiving a VM from a phone plugged in by USB, in its File transfer (MTP) mode. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Tagged heap pointers cannot pass through TCG's host-pointer arithmetic.
         The app is declared a game: a phone holds an ordinary app's CPU clocks down long before it
         is warm (a OnePlus let the vCPUs have 1.6 to 2.4 of 3.6 GHz with its thermal status at
         "none"), and its game mode and performance settings apply to games. -->
    <application
        android:name=".App"
        android:appCategory="game"
        android:isGame="true"
        android:allowBackup="false"
        android:allowNativeHeapPointerTagging="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vphone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A .vphone VM file, opened from Quick Share, a file manager, or shared to vphone. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-vphone-vm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VmActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CreateActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Vphone" />

        <!-- The VM's screen during creation; follows rotation, its Surface crosses to :createvm. -->
        <activity
            android:name=".CreateVmScreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="false"
            android:theme="@style/Theme.Vphone" />

        <activity
            android:name=".CreateLogActivity"
            android:exported="false"
            android:theme="@style/Theme.Vphone" />

        <activity
            android:name=".VmLogActivity"
            android:exported="false"
            android:theme="@style/Theme.Vphone" />

        <!-- One VM's settings, opened from its card in the list. -->
        <activity
            android:name=".VmSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Vphone" />

        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.Vphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!-- Runs the creation; QEMU boots start in the bound process below. -->
        <service
            android:name=".CreateService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":create"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Creates a user-started iOS virtual machine, a process of many hours, while the app is not on screen" />
        </service>

        <!-- A reboot mid-create resumes it. -->
        <!-- PackageInstaller's answer to an update's install. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <receiver
            android:name=".CreateBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".VmService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started iOS virtual machine, and imports its disk images, while the app is not on screen" />
        </service>
    </application>
</manifest>
